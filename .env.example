# Veyra — exemplo de ambiente (APENAS placeholders; nunca commitar .env real)
# Validado no boot por apps/api/src/common/env.ts (fail-fast).

NODE_ENV=development
PORT=3001

# Postgres do docker-compose (porta host 5434). Obrigatória a partir da Entrega 1.
DATABASE_URL=postgresql://veyra:veyra_dev@localhost:5434/veyra

# Auth (Entrega 2). Gere um segredo real com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
WEB_ORIGIN=http://localhost:5175
