# Veyra — exemplo de ambiente (APENAS placeholders; nunca commitar .env real)
# Validado no boot por apps/api/src/common/env.ts (fail-fast).

NODE_ENV=development
PORT=3001

# Postgres do docker-compose (porta host 5434). Obrigatória a partir da Entrega 1.
DATABASE_URL=postgresql://veyra:veyra_dev@localhost:5434/veyra

# Auth (Entrega 2). Gere um segredo real com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
WEB_ORIGIN=http://localhost:5175

# Cifra de segredos em repouso (webhooks, integrações). openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=troque-por-uma-chave-independente-do-jwt
AUDIT_RETENTION_DAYS=365

# Raiz do storage local de arquivos (Entrega 6.3, ADR-024). Com S3 vira bucket.
STORAGE_ROOT=.storage

# IA (Entrega 7). SEM a chave o produto continua funcionando: cada capacidade
# degrada com clareza — o score de lead, por exemplo, segue sendo calculado.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
