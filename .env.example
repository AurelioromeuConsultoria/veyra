# Veyra — exemplo de ambiente (APENAS placeholders; nunca commitar .env real)
# Validado no boot por apps/api/src/common/env.ts (fail-fast).

NODE_ENV=development
# Ambiente LÓGICO — separado de NODE_ENV. Existe para autorizar o que não pode
# existir em produção (hoje, o transporte falso do WhatsApp, ADR-046).
# Produção seta `production` EXPLICITAMENTE: o default é `development`, e uma
# verificação futura que dependa de `VEYRA_ENV === 'production'` nasceria falsa.
VEYRA_ENV=development
PORT=3001

# Postgres do docker-compose (porta host 5434). Obrigatória a partir da Entrega 1.
DATABASE_URL=postgresql://veyra:veyra_dev@localhost:5434/veyra

# Auth (Entrega 2). Gere um segredo real com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
WEB_ORIGIN=http://localhost:5175

# Cifra de segredos em repouso (webhooks, integrações). openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=troque-por-uma-chave-independente-do-jwt
# Chave do HMAC das travas de endereço (ADR-052 item 3): obrigatória, ESTÁVEL
# entre reinícios e independente das outras. openssl rand -base64 48. Rotação só
# em manutenção (docs/SECURITY.md §8).
ADDRESS_LOCK_KEY=troque-por-outra-chave-independente-e-estavel
# Chave do HMAC da aprovação do envio do negócio (approvalHash, ADR-052 item 8):
# obrigatória, a MESMA em todos os processos e independente das outras. Trocá-la
# invalida as aprovações pendentes (approval_stale). openssl rand -base64 48.
OUTBOUND_APPROVAL_KEY=troque-por-uma-chave-da-aprovacao-independente
AUDIT_RETENTION_DAYS=365
# Prazo do CONTEÚDO derivado de conversa em AiRun.result (ADR-042). Menor que o
# da auditoria: a trilha de quem fez o quê vale mais tempo que o texto do modelo.
AI_RESULT_RETENTION_DAYS=90

# Raiz do storage local de arquivos (Entrega 6.3, ADR-024). Com S3 vira bucket.
STORAGE_ROOT=.storage

# IA (Entrega 7). SEM a chave o produto continua funcionando: cada capacidade
# degrada com clareza — o score de lead, por exemplo, segue sendo calculado.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Canal WhatsApp (Entrega 9.1, ADR-037). O app secret e o verify_token são do
# Meta App e vivem AQUI, não por canal. Sem eles o canal não é configurável.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# Scanner de arquivos (ADR-043). VAZIO = sem scanner: o arquivo fica `pending` e
# não sai para canal externo. `docker compose --profile scanner up -d clamav`
# sobe o serviço local; o primeiro boot baixa a base e leva alguns minutos.
CLAMAV_HOST=
CLAMAV_PORT=3310
