// Fundação de tenancy (Entrega 1). Convenções: docs/DOMAIN_MODEL.md §1;
// isolamento: docs/SECURITY.md §2; FKs compostas: ADR-010.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
}

enum WorkspaceStatus {
  active
  suspended
}

enum MembershipStatus {
  active
  suspended
  removed
}

// ─── Identidade global (fora do filtro de workspace — SECURITY.md §2) ───────

/// Usuário GLOBAL (ADR-003): sem workspaceId; participa de workspaces via
/// Membership. Acesso sempre via prisma.raw (auth/identidade), justificado.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
}

/// Sessão global (ADR-008): token armazenado só como SHA-256, rotação real.
/// activeMembershipId lembra o workspace ativo entre refreshes; a FK composta
/// (userId, activeMembershipId) → Membership(userId, id) garante NO BANCO que a
/// membership pertence ao dono do token (ADR-018). Nativa no schema (Prisma 7
/// aceita nulidade mista) — a versão em SQL manual foi dropada por um migrate
/// dev e recriada aqui, rastreada; o teste de integração da FK pegou o drift.
model RefreshToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenHash          String    @unique
  activeMembershipId String?   @db.Uuid
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership Membership? @relation("SessionActiveMembership", fields: [userId, activeMembershipId], references: [userId, id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, activeMembershipId])
}

/// Raiz do tenant: exclusão LGPD via cascade a partir daqui.
model Workspace {
  id        String          @id @default(uuid()) @db.Uuid
  name      String
  slug      String          @unique
  status    WorkspaceStatus @default(active)
  settings  Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  roles                  Role[]
  memberships            Membership[]
  invites                Invite[]
  companies              Company[]
  contacts               Contact[]
  tags                   Tag[]
  customFieldDefinitions CustomFieldDefinition[]
  pipelines              Pipeline[]
  deals                  Deal[]
  tasksList              Task[]
  notes                  Note[]
  activities             Activity[]
  auditLogs              AuditLog[]
  idempotencyKeys        IdempotencyKey[]
  outboxEvents           OutboxEvent[]
  webhooks               Webhook[]
  channels               Channel[]
  conversations          Conversation[]
  messages               Message[]
  calendarEvents         CalendarEvent[]
  notifications          Notification[]
  files                  FileObject[]
  aiRuns                 AiRun[]
  aiProposals            AiProposal[]
  aiConsent              AiConsent?
}

/// Catálogo GLOBAL de permissões (ADR-004): chaves estáveis do sistema —
/// exceção documentada à regra do workspaceId (é catálogo, não dado de tenant).
model Permission {
  key         String @id
  description String

  rolePermissions RolePermission[]
}

// ─── Dados de acesso por workspace (tenant-scoped, em WORKSPACE_MODELS) ─────

/// Role SEMPRE pertence a um workspace (ADR-004); padrões semeados no
/// provisionamento com isSystem=true. Não existe Role global.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false)
  /// Papel de SISTEMA identificado por chave estável ('owner'|'admin'|'member'|
  /// 'guest'), não por nome (ADR-004/017): invariantes de ciclo de vida (último
  /// Owner) ramificam por systemKey; null para papéis customizados.
  systemKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invites     Invite[]

  // Alvo de FK composta (ADR-010): quem referencia Role referencia (workspaceId, id)
  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@unique([workspaceId, systemKey])
}

/// Junção Role↔Permission, tenant-scoped.
model RolePermission {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @db.Uuid
  roleId        String @db.Uuid
  permissionKey String

  // FK composta: impede vincular permissão a role de OUTRO workspace no banco
  role       Role       @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@unique([workspaceId, roleId, permissionKey])
  @@index([workspaceId, roleId])
}

/// Ponte User↔Workspace (ADR-003), tenant-scoped. tokenVersion viaja no JWT e
/// invalida sessões quando a membership muda (ADR-009).
model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @db.Uuid
  userId       String           @db.Uuid
  roleId       String           @db.Uuid
  status       MembershipStatus @default(active)
  tokenVersion Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // FK composta (ADR-010): Membership não pode apontar para Role de outro workspace
  role      Role      @relation(fields: [workspaceId, roleId], references: [workspaceId, id])

  ownedCompanies        Company[]       @relation("CompanyOwner")
  ownedContacts         Contact[]       @relation("ContactOwner")
  activeSessions        RefreshToken[]  @relation("SessionActiveMembership")
  ownedDeals            Deal[]          @relation("DealOwner")
  assignedTasks         Task[]          @relation("TaskAssignee")
  authoredNotes         Note[]          @relation("NoteAuthor")
  activities            Activity[]      @relation("ActivityActor")
  auditLogs             AuditLog[]      @relation("AuditActor")
  assignedConversations Conversation[]  @relation("ConversationAssignee")
  authoredMessages      Message[]       @relation("MessageAuthorMembership")
  organizedEvents       CalendarEvent[] @relation("EventOrganizer")
  notifications         Notification[]  @relation("NotificationRecipient")
  uploadedFiles         FileObject[]    @relation("FileUploader")
  aiRuns                AiRun[]         @relation("AiRunTrigger")
  reviewedProposals     AiProposal[]    @relation("ProposalReviewer")
  consentChanges        AiConsent[]     @relation("ConsentAuthor")

  // Alvo de FK composta para Team/ownership futuros
  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  // Alvo da FK composta de RefreshToken (userId, activeMembershipId): o banco
  // garante que o workspace ativo de uma sessão pertence ao dono da sessão
  @@unique([userId, id])
  @@index([workspaceId, roleId])
  @@index([userId])
}

/// Convite: a porta de entrada sem registro público (ADR-014).
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  email       String
  roleId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, email])
  // custo do ON DELETE CASCADE da FK composta (exclusão de Role varre Invite)
  @@index([workspaceId, roleId])
}

// ─── CRM: relacionamento (Entrega 3) ─────────────────────────────────────────

enum ContactStatus {
  active
  archived
}

enum CompanySize {
  solo
  small
  medium
  large
  enterprise
}

enum TagColor {
  slate
  stone
  accent
  positive
  negative
  warning
  info
}

enum CustomFieldEntity {
  contact
  company
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multiselect
}

model Company {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @db.Uuid
  name              String
  domain            String?
  size              CompanySize?
  ownerMembershipId String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK composta com nulidade mista (MATCH SIMPLE ignora quando NULL).
  // NoAction ≠ Restrict: a checagem ocorre ao FIM do statement (não imediata),
  // o que deixa o cascade do Workspace concluir. NÃO é DEFERRABLE (não adia ao
  // commit) — comportamento coberto pelo teste de exclusão de workspace.
  // SET NULL anularia TODAS as colunas da FK, inclusive workspaceId — proibido.
  owner      Membership?  @relation("CompanyOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contacts   Contact[]
  tags       CompanyTag[]
  deals      Deal[]
  notes      Note[]
  activities Activity[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, domain])
  @@index([workspaceId, name])
}

model Contact {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  name              String
  emails            String[]      @default([])
  phones            String[]      @default([])
  status            ContactStatus @default(active)
  companyId         String?       @db.Uuid
  ownerMembershipId String?       @db.Uuid
  source            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company?     @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  owner      Membership?  @relation("ContactOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  tags       ContactTag[]
  deals      Deal[]
  tasksList  Task[]
  notes      Note[]
  activities Activity[]

  conversations  Conversation[]
  messages       Message[]       @relation("MessageAuthorContact")
  calendarEvents CalendarEvent[]
  aiProposals    AiProposal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, name])
  @@index([workspaceId, companyId])
  @@index([workspaceId, ownerMembershipId])
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  color       TagColor @default(slate)
  createdAt   DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]
  companyTags CompanyTag[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

model ContactTag {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  contactId   String @db.Uuid
  tagId       String @db.Uuid

  contact Contact @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, contactId, tagId])
  @@index([workspaceId, tagId])
}

model CompanyTag {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  companyId   String @db.Uuid
  tagId       String @db.Uuid

  company Company @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, companyId, tagId])
  @@index([workspaceId, tagId])
}

model CustomFieldDefinition {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  entityType  CustomFieldEntity
  /// chave estável (snake_case) usada nas APIs — imutável após criada
  key         String
  label       String
  type        CustomFieldType
  options     String[]          @default([])
  required    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, entityType, key])
}

/// Valor tipado pela definição. `entityId` NÃO tem FK — exceção documentada
/// (DOMAIN_MODEL §9): tenant-scoped, não navegável; a limpeza é responsabilidade
/// do service que exclui a entidade (delete de contato/empresa apaga os values).
model CustomFieldValue {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @db.Uuid
  definitionId String            @db.Uuid
  entityType   CustomFieldEntity
  entityId     String            @db.Uuid
  value        Json

  definition CustomFieldDefinition @relation(fields: [workspaceId, definitionId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, definitionId, entityId])
  @@index([workspaceId, entityType, entityId])
}

// ─── CRM: vendas e trabalho (Entrega 4) ──────────────────────────────────────

enum StageType {
  open
  won
  lost
}

enum DealStatus {
  open
  won
  lost
}

enum TaskStatus {
  open
  done
}

enum TaskPriority {
  low
  normal
  high
}

enum ActivityType {
  contact_created
  deal_created
  deal_stage_changed
  deal_updated
  deal_won
  deal_lost
  task_created
  task_completed
  note_added
  note_deleted
  message_sent
  message_received
  event_scheduled
}

enum ActivityActor {
  user
  system
}

model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  /// Unique parcial ESTRUTURAL (ajuste #2): TRUE ou NULL, nunca false — o
  /// @@unique([workspaceId, defaultMark]) garante no banco um só default por
  /// workspace (NULLs não colidem), sem SQL manual e sem risco de drift.
  defaultMark Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@unique([workspaceId, defaultMark])
}

model Stage {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  pipelineId  String    @db.Uuid
  name        String
  order       Int
  probability Int?
  type        StageType @default(open)

  pipeline Pipeline @relation(fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Cascade)
  deals    Deal[]

  @@unique([workspaceId, id])
  // Alvo da FK TRIPLA do Deal (ajuste #1): o banco garante stage∈pipeline
  @@unique([workspaceId, pipelineId, id])
  @@unique([workspaceId, pipelineId, name])
  @@index([workspaceId, pipelineId, order])
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @db.Uuid
  pipelineId        String     @db.Uuid
  stageId           String     @db.Uuid
  title             String
  contactId         String?    @db.Uuid
  companyId         String?    @db.Uuid
  ownerMembershipId String?    @db.Uuid
  amountCents       Int        @default(0)
  currency          String     @default("BRL")
  expectedCloseDate DateTime?
  status            DealStatus @default(open)
  /// ordenação na coluna do kanban (gaps de 1024, rebalanceado sob lock)
  position          Int
  /// atualizado ao mover de stage — insumo do "oportunidade parada" (E7)
  stageEnteredAt    DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline    @relation(fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  // FK TRIPLA (ajuste #1): stage do MESMO pipeline, garantido no banco —
  // deal com pipelineId de A e stageId de B é violação de FK, não bug de service
  stage     Stage       @relation(fields: [workspaceId, pipelineId, stageId], references: [workspaceId, pipelineId, id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact?    @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  company   Company?    @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  owner     Membership? @relation("DealOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  calendarEvents CalendarEvent[]
  aiProposals    AiProposal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, pipelineId, stageId, position])
  @@index([workspaceId, contactId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, ownerMembershipId])
  @@index([workspaceId, status])
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  workspaceId          String       @db.Uuid
  title                String
  description          String?
  dueAt                DateTime?
  assigneeMembershipId String?      @db.Uuid
  status               TaskStatus   @default(open)
  priority             TaskPriority @default(normal)
  contactId            String?      @db.Uuid
  dealId               String?      @db.Uuid
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  Membership? @relation("TaskAssignee", fields: [workspaceId, assigneeMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact?    @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  deal      Deal?       @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)

  activities Activity[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, assigneeMembershipId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
}

model Note {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  body               String
  authorMembershipId String   @db.Uuid
  contactId          String?  @db.Uuid
  companyId          String?  @db.Uuid
  dealId             String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    Membership @relation("NoteAuthor", fields: [workspaceId, authorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact?   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  company   Company?   @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  deal      Deal?      @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, contactId, createdAt])
  @@index([workspaceId, companyId])
  @@index([workspaceId, dealId, createdAt])
  @@index([workspaceId, authorMembershipId])
}

/// Timeline (ADR-011): APPEND-ONLY, sem API de escrita — só ActivitiesService
/// emite, com payload validado por mapa fechado ActivityType→Zod (ajuste #4).
/// Referências por FKs EXPLÍCITAS compostas, com Cascade: o histórico morre com
/// a entidade (LGPD) — nunca par genérico entityType/entityId.
model Activity {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  type              ActivityType
  actorType         ActivityActor @default(user)
  actorMembershipId String?       @db.Uuid
  payload           Json
  occurredAt        DateTime      @default(now())
  contactId         String?       @db.Uuid
  companyId         String?       @db.Uuid
  dealId            String?       @db.Uuid
  taskId            String?       @db.Uuid
  conversationId    String?       @db.Uuid
  calendarEventId   String?       @db.Uuid

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor         Membership?    @relation("ActivityActor", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact       Contact?       @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  company       Company?       @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  deal          Deal?          @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  task          Task?          @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [workspaceId, calendarEventId], references: [workspaceId, id], onDelete: Cascade)

  // cursor keyset (occurredAt, id) por alvo — paginação estável (ajuste #5)
  @@index([workspaceId, contactId, occurredAt(sort: Desc), id])
  @@index([workspaceId, dealId, occurredAt(sort: Desc), id])
  @@index([workspaceId, conversationId, occurredAt(sort: Desc), id])
}

// ─── Plataforma de confiança (Entrega 5) ─────────────────────────────────────

enum AuditActor {
  user
  api
  system
  ai
}

/// Trilha de auditoria: APPEND-ONLY (bloqueado no PrismaService) e MINIMIZADA —
/// before/after passam por allowlist de campos por entidade, com redaction
/// (SECURITY.md §5). Retenção de 12 meses via job (prisma.raw justificado).
model AuditLog {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @db.Uuid
  actorType         AuditActor @default(user)
  /// membership do ator quando é usuário do workspace (FK composta)
  actorMembershipId String?    @db.Uuid
  /// identificador da ORIGEM quando não é usuário: id da API key, nome do job,
  /// serviço ou AiRun (ajuste #2) — actorMembershipId não serve para esses casos
  actorId           String?
  action            String
  entityType        String
  entityId          String     @db.Uuid
  before            Json?
  after             Json?
  requestId         String?
  createdAt         DateTime   @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     Membership? @relation("AuditActor", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, entityType, entityId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc), id])
}

enum IdempotencyState {
  processing
  completed
}

/// Idempotência HTTP com RESERVA ATÔMICA (ajuste #3): a chave é reservada como
/// `processing` ANTES de executar; dois requests idênticos concorrentes não
/// executam duas vezes. requestHash cobre método + rota canônica + params +
/// body normalizado. 5xx/rollback liberam a reserva (linha é apagada).
model IdempotencyKey {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  key            String
  endpoint       String
  requestHash    String
  state          IdempotencyState @default(processing)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, endpoint])
  @@index([expiresAt])
}

enum OutboxStatus {
  pending
  /// reivindicado por um worker: invisível para os demais até o lease expirar
  processing
  delivered
  failed
  dead
}

/// Outbox transacional: o efeito externo é gravado na MESMA transação do
/// domínio e entregue depois pelo worker — nunca escapa se a transação abortar.
model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  workspaceId    String       @db.Uuid
  eventType      String
  payload        Json
  dedupeKey      String
  status         OutboxStatus @default(pending)
  attempts       Int          @default(0)
  nextRetryAt    DateTime     @default(now())
  /// LEASE: quando o worker reivindicou e até quando o claim vale. Worker que
  /// morre no meio libera o evento pela expiração — sem lease, o `SKIP LOCKED`
  /// só protege durante o UPDATE e outra instância entregaria em paralelo.
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  /// FENCING TOKEN: identifica QUEM detém o lease atual. Sem ele, um worker
  /// lento que perdeu o lease por expiração ainda conseguiria marcar o evento
  /// como delivered, sobrescrevendo o trabalho de quem o reivindicou depois.
  claimToken     String?      @db.Uuid
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([status, nextRetryAt])
  @@index([status, leaseExpiresAt])
}

enum WebhookStatus {
  active
  paused
  disabled
}

model Webhook {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  url          String
  events       String[]      @default([])
  /// segredo HMAC cifrado (AES-256-GCM) — JAMAIS em DTO, log ou auditoria
  secretCipher String
  status       WebhookStatus @default(active)
  /// conta ENTREGAS MORTAS consecutivas (ajuste #7), não tentativas
  failureCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

/// Histórico de entrega (ajuste #4): FKs COMPOSTAS para Webhook e OutboxEvent,
/// com unicidade por tentativa — o banco impede registro cross-workspace e
/// duplicidade de tentativa.
model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  webhookId      String   @db.Uuid
  outboxEventId  String   @db.Uuid
  attempt        Int
  responseStatus Int?
  error          String?
  durationMs     Int
  createdAt      DateTime @default(now())

  webhook     Webhook     @relation(fields: [workspaceId, webhookId], references: [workspaceId, id], onDelete: Cascade)
  outboxEvent OutboxEvent @relation(fields: [workspaceId, outboxEventId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, webhookId, outboxEventId, attempt])
  @@index([workspaceId, webhookId, createdAt(sort: Desc)])
}

// ─── Comunicação (Entrega 6.1) ────────────────────────────────────────────────

/// Canal de comunicação. `email`/`whatsapp` estão reservados no enum, mas a API
/// desta entrega aceita SOMENTE `internal` (ADR-023).
enum ChannelType {
  internal
  email
  whatsapp
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageAuthor {
  contact
  user
  ai
  system
}

model Channel {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  type        ChannelType
  name        String
  /// EXATAMENTE UM canal interno por workspace, garantido pelo banco: TRUE ou
  /// NULL + unique composto (mesmo padrão de `Pipeline.defaultMark`). Nenhum
  /// service precisa se lembrar da invariante.
  systemMark  Boolean?
  createdAt   DateTime    @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, systemMark])
  @@index([workspaceId, type])
}

model Conversation {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @db.Uuid
  channelId            String             @db.Uuid
  contactId            String?            @db.Uuid
  subject              String?
  status               ConversationStatus @default(open)
  assigneeMembershipId String?            @db.Uuid
  /// SEMPRE preenchido (default now() na criação): o keyset do inbox não tem
  /// caso especial de null.
  lastMessageAt        DateTime           @default(now())
  createdAt            DateTime           @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel      @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  assignee    Membership?  @relation("ConversationAssignee", fields: [workspaceId, assigneeMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  messages    Message[]
  activities  Activity[]
  aiProposals AiProposal[]

  @@unique([workspaceId, id])
  // alvo da FK TRIPLA de Message: o banco garante que a mensagem não pode
  // apontar para a conversa A usando o canal B (mesma classe da FK tripla
  // Deal→Stage, ADR-010)
  @@unique([workspaceId, channelId, id])
  // cursor keyset do inbox: (lastMessageAt, id) desc, por status
  @@index([workspaceId, status, lastMessageAt(sort: Desc), id])
  @@index([workspaceId, lastMessageAt(sort: Desc), id])
  @@index([workspaceId, contactId])
  @@index([workspaceId, assigneeMembershipId])
}

model Message {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @db.Uuid
  conversationId     String           @db.Uuid
  /// derivado da conversa NO SERVIDOR (nunca do cliente) — existe para o unique
  /// de dedup de ingestão externa, que é por canal
  channelId          String           @db.Uuid
  direction          MessageDirection
  authorType         MessageAuthor
  authorMembershipId String?          @db.Uuid
  authorContactId    String?          @db.Uuid
  body               String
  externalId         String?
  deliveredAt        DateTime?
  createdAt          DateTime         @default(now())

  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK TRIPLA: canal da mensagem = canal da conversa, garantido pelo banco
  conversation     Conversation        @relation(fields: [workspaceId, channelId, conversationId], references: [workspaceId, channelId, id], onDelete: Cascade)
  channel          Channel             @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  authorMembership Membership?         @relation("MessageAuthorMembership", fields: [workspaceId, authorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  authorContact    Contact?            @relation("MessageAuthorContact", fields: [workspaceId, authorContactId], references: [workspaceId, id], onDelete: Cascade)
  attachments      MessageAttachment[]

  @@unique([workspaceId, id])
  // dedup de ingestão externa (nulos não colidem: mensagem interna não tem externalId)
  @@unique([workspaceId, channelId, externalId])
  @@index([workspaceId, conversationId, createdAt(sort: Desc), id])
}

// ─── Organização: agenda e notificações (Entrega 6.2) ─────────────────────────

enum CalendarEventStatus {
  scheduled
  done
  canceled
}

model CalendarEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  workspaceId           String              @db.Uuid
  title                 String
  description           String?
  /// CHECK "endAt" > "startAt" no banco: invariante de tempo não depende do
  /// service (migration 20260820190000_calendar_notifications)
  startAt               DateTime
  endAt                 DateTime
  location              String?
  status                CalendarEventStatus @default(scheduled)
  organizerMembershipId String              @db.Uuid
  contactId             String?             @db.Uuid
  dealId                String?             @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer  Membership @relation("EventOrganizer", fields: [workspaceId, organizerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact    Contact?   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  activities Activity[]

  @@unique([workspaceId, id])
  // agenda é sempre consultada por janela de tempo
  @@index([workspaceId, startAt])
  @@index([workspaceId, organizerMembershipId, startAt])
  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
}

/// Notificação PESSOAL: sempre lida pelo próprio destinatário. `dedupeKey`
/// torna a emissão idempotente — retry do mesmo fato não gera segunda notificação.
model Notification {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @db.Uuid
  recipientMembershipId String    @db.Uuid
  type                  String
  payload               Json
  dedupeKey             String
  readAt                DateTime?
  createdAt             DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Membership @relation("NotificationRecipient", fields: [workspaceId, recipientMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  // caixa pessoal: não lidas primeiro, mais recentes no topo
  @@index([workspaceId, recipientMembershipId, readAt, createdAt(sort: Desc)])
}

// ─── Arquivos (Entrega 6.3) ───────────────────────────────────────────────────

/// pending → nunca saiu para canal externo; clean → liberado; quarantined →
/// nem download interno. Marcar clean exige scanner real (SECURITY.md §7.5).
enum FileScanStatus {
  pending
  clean
  quarantined
}

model FileObject {
  id                     String         @id @default(uuid()) @db.Uuid
  workspaceId            String         @db.Uuid
  /// chave no storage, SEMPRE derivada no servidor: {workspaceId}/{uuid}{ext}
  key                    String
  fileName               String
  /// MIME DETECTADO por magic bytes — nunca o declarado pelo cliente (ADR-025)
  mimeType               String
  sizeBytes              Int
  uploadedByMembershipId String         @db.Uuid
  scanStatus             FileScanStatus @default(pending)
  createdAt              DateTime       @default(now())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy  Membership          @relation("FileUploader", fields: [workspaceId, uploadedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  attachments MessageAttachment[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, scanStatus])
}

/// Anexo de mensagem: as DUAS pontas em FK composta — anexo não alcança
/// mensagem nem arquivo de outro workspace.
model MessageAttachment {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @db.Uuid
  messageId    String @db.Uuid
  fileObjectId String @db.Uuid

  message Message    @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)
  file    FileObject @relation(fields: [workspaceId, fileObjectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, messageId, fileObjectId])
  @@index([workspaceId, fileObjectId])
}

// ─── Inteligência (Entrega 7) ─────────────────────────────────────────────────

enum AiRunStatus {
  ok
  refused
  error
}

enum AiRunAction {
  none
  proposed
  executed
}

enum AiProposalStatus {
  pending
  approved
  rejected
  expired
}

/// Tipos de proposta PERMITIDOS. O modelo não inventa tipo: a saída é validada
/// contra esta lista e contra o schema Zod estrito do payload (ADR-029).
enum AiProposalType {
  create_task
}

/// Catálogo GLOBAL de prompts versionados (como Permission): mudar prompt é
/// versão nova, nunca edição silenciosa. Não é dado de tenant.
model PromptVersion {
  id         String   @id @default(uuid()) @db.Uuid
  capability String
  version    Int
  /// sha256 do texto do prompt — detecta edição sem bump de versão
  hash       String
  changelog  String
  createdAt  DateTime @default(now())

  runs AiRun[]

  @@unique([capability, version])
}

model AiRun {
  id                      String      @id @default(uuid()) @db.Uuid
  workspaceId             String      @db.Uuid
  capability              String
  promptVersionId         String?     @db.Uuid
  model                   String
  /// DESCRIÇÃO do contexto (quais entidades/campos), NUNCA o payload bruto,
  /// corpo de mensagem, prompt ou segredo — vale também para runs com erro
  contextSummary          String
  status                  AiRunStatus
  /// código curto do motivo (ex.: 'no_consent', 'invalid_output', 'provider_error');
  /// jamais stack trace ou mensagem do provedor
  reasonCode              String?
  inputTokens             Int         @default(0)
  outputTokens            Int         @default(0)
  costCents               Int         @default(0)
  latencyMs               Int         @default(0)
  action                  AiRunAction @default(none)
  triggeredByMembershipId String?     @db.Uuid
  createdAt               DateTime    @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id])
  triggeredBy   Membership?    @relation("AiRunTrigger", fields: [workspaceId, triggeredByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  proposals     AiProposal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, capability, createdAt(sort: Desc)])
}

/// Ação externa proposta pela IA: só existe executada DEPOIS de aprovação
/// humana (princípio 4). Alvos por colunas FK tipadas — nunca polimorfismo solto.
model AiProposal {
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @db.Uuid
  runId                  String           @db.Uuid
  type                   AiProposalType
  payload                Json
  rationale              String
  status                 AiProposalStatus @default(pending)
  contactId              String?          @db.Uuid
  dealId                 String?          @db.Uuid
  conversationId         String?          @db.Uuid
  reviewedByMembershipId String?          @db.Uuid
  reviewedAt             DateTime?
  expiresAt              DateTime
  createdAt              DateTime         @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run          AiRun         @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  reviewedBy   Membership?   @relation("ProposalReviewer", fields: [workspaceId, reviewedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/// Consentimento do workspace (ADR-028): UMA flag, desligada por padrão.
model AiConsent {
  workspaceId           String   @id @db.Uuid
  /// corpo de mensagem pode entrar no prompt? default NÃO
  conversationContent   Boolean  @default(false)
  updatedByMembershipId String?  @db.Uuid
  updatedAt             DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK composta: quem mudou o consentimento é membership DESTE workspace
  updatedBy Membership? @relation("ConsentAuthor", fields: [workspaceId, updatedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
}
