// Veyra Clinics — vertical para clínicas de estética (ADR-047, ADR-048).
//
// Arquivo DO VERTICAL: o Core não o conhece. As FKs para entidades do Core
// moram aqui, sempre COMPOSTAS por (workspaceId, id) (ADR-010); o arquivo do
// Core só tem o lado reverso que o Prisma exige (ADR-047 adendo 2, item 1).
// Todo modelo daqui entra no registro composto pela extensão (`clinicsExtension`)
// e é coberto pela checagem de PRESENÇA da porta de restrição de conteúdo.

enum ClinicsActivationStatus {
  active
  disabled
}

/// Consumidores liberáveis por contato (ADR-048 §6.4). No MVP, só IA:
/// webhooks não têm liberação.
enum ClinicsReleaseConsumer {
  ai
}

/// Motivo da liberação, por LISTA FECHADA (ADR-047 adendo 2, item 5).
enum ClinicsReleaseReason {
  supplier
  partner
  staff
  non_clinical_business
}

/// Ativação do vertical no workspace (ADR-047 §4), 1:1. Classe C (ADR-048 §6):
/// não identifica pessoa. NUNCA é apagada pelo vertical — desativar muda o
/// status, e a restrição de conteúdo depende da PRESENÇA, não do status.
model ClinicsSettings {
  id          String                  @id @default(uuid()) @db.Uuid
  workspaceId String                  @unique @db.Uuid
  status      ClinicsActivationStatus @default(active)
  activatedAt DateTime                @default(now())
  disabledAt  DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
}

/// Unidade da clínica. Classe C. Nasce uma ("Unidade principal") na ativação;
/// no MVP é UMA por workspace (ADR-048 adendo 1, item 2). O fuso existe porque
/// horário de atendimento é hora LOCAL da unidade, e o Core não tem fuso.
model ClinicsUnit {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  name        String
  /// IANA (ex.: America/Sao_Paulo), validado contra a lista do runtime
  timezone    String    @default("America/Sao_Paulo")
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workingHours ClinicsWorkingHours[]
  appointments ClinicsAppointment[]
  returns      ClinicsReturn[]
  payments     ClinicsPackagePayment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, archivedAt])
}

/// Serviço do catálogo. Classe C (ADR-048 adendo 1, item 1). Arquivado, nunca
/// apagado: a agenda da F2 vai referenciá-lo. Dinheiro em centavos (`Int`).
model ClinicsService {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  name               String
  durationMin        Int
  /// opcional: possibilidade preservada (ADR-048 §8), sem nada financeiro
  priceCents         Int?
  currency           String    @default("BRL")
  /// dias até o retorno automático, da data local do atendimento; `null` = sem retorno (F3.2)
  returnIntervalDays Int?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  professionals ClinicsProfessionalService[]
  appointments  ClinicsAppointment[]
  packages      ClinicsPackage[]
  returns       ClinicsReturn[]

  @@unique([workspaceId, id])
  @@index([workspaceId, archivedAt])
}

/// Quem atende (ADR-048 §3). Classe P: só o nome, por minimização. O vínculo
/// com uma conta é OPCIONAL e único por conta; não muda papel nenhum.
model ClinicsProfessional {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  name         String
  membershipId String?   @db.Uuid
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace    Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership   Membership?                  @relation("ClinicsProfessionalAccount", fields: [workspaceId, membershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  services     ClinicsProfessionalService[]
  workingHours ClinicsWorkingHours[]
  appointments ClinicsAppointment[]
  attendances  ClinicsAttendance[]

  @@unique([workspaceId, membershipId])
  @@unique([workspaceId, id])
  @@index([workspaceId, archivedAt])
}

/// Serviços que um profissional faz. Substituído como CONJUNTO (adendo 1, item 4).
model ClinicsProfessionalService {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  professionalId String   @db.Uuid
  serviceId      String   @db.Uuid
  createdAt      DateTime @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  professional ClinicsProfessional @relation(fields: [workspaceId, professionalId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  service      ClinicsService      @relation(fields: [workspaceId, serviceId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, professionalId, serviceId])
  @@unique([workspaceId, id])
  @@index([workspaceId, serviceId])
}

/// Intervalo semanal de atendimento (adendo 1, item 5). Dia ISO (1 = segunda),
/// minutos do dia na hora LOCAL da unidade. Sobreposição do mesmo profissional
/// no mesmo dia é barrada pelo banco: EXCLUDE USING gist, em SQL manual na
/// migration (o Prisma não declara exclusão), com CHECKs de faixa.
model ClinicsWorkingHours {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  professionalId String   @db.Uuid
  unitId         String   @db.Uuid
  weekday        Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  professional ClinicsProfessional @relation(fields: [workspaceId, professionalId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  unit         ClinicsUnit         @relation(fields: [workspaceId, unitId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  @@index([workspaceId, professionalId])
  @@index([workspaceId, unitId])
}

/// Liberação explícita de um contato SEM relação com o Clinics, por consumidor
/// (ADR-048 §6.4). Classe P. Revogar APAGA a linha; a prova fica na auditoria.
/// CASCADE a partir do contato: é dado sobre ele e não pode bloquear a
/// exclusão de contato do Core (ADR-022).
model ClinicsContactRelease {
  id                     String                 @id @default(uuid()) @db.Uuid
  workspaceId            String                 @db.Uuid
  contactId              String                 @db.Uuid
  consumer               ClinicsReleaseConsumer
  reason                 ClinicsReleaseReason
  releasedByMembershipId String                 @db.Uuid
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact    @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  releasedBy Membership @relation("ClinicsReleaseGrantedBy", fields: [workspaceId, releasedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, contactId, consumer])
  @@unique([workspaceId, id])
  @@index([workspaceId, releasedByMembershipId])
}

/// Perfil de PACIENTE sobre um contato (ADR-048 §4 e adendo 2, itens 1 a 3).
/// Classe S: liga uma pessoa a atendimento. Só o vínculo, quem criou e quando
/// — nada clínico, nenhum texto (H7). Criar é ato EXPLÍCITO e torna o contato
/// restrito para IA com ou sem liberação. FK para o contato com NO ACTION:
/// excluir contato que é paciente é recusado (409, §9.1) até a decisão
/// jurídica (B3).
model ClinicsPatient {
  id                    String   @id @default(uuid()) @db.Uuid
  workspaceId           String   @db.Uuid
  contactId             String   @db.Uuid
  createdByMembershipId String   @db.Uuid
  createdAt             DateTime @default(now())

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact              @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    Membership           @relation("ClinicsPatientCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  appointments ClinicsAppointment[]
  packages     ClinicsPackage[]
  returns      ClinicsReturn[]

  @@unique([workspaceId, contactId])
  @@unique([workspaceId, id])
  @@index([workspaceId, createdByMembershipId])
}

/// Estado do agendamento (ADR-048 §4 e adendo 4, item 6). `attended` só pelo
/// registro de atendimento.
enum ClinicsAppointmentStatus {
  scheduled
  confirmed
  arrived
  canceled
  no_show
  attended
}

/// Motivo de cancelamento, por LISTA FECHADA: sem "outro" e sem texto livre.
enum ClinicsCancelReason {
  patient_request
  clinic_request
  professional_unavailable
  scheduling_error
}

/// Agendamento (ADR-048 adendo 2, item 4; adendo 4). Classe S: liga um
/// paciente a um atendimento. Sem texto livre. `startsAt`/`endsAt` são
/// INSTANTES (`timestamptz`): a hora local é só leitura, no fuso da unidade.
/// `endsAt` é GRAVADO com a duração do serviço no momento do agendamento —
/// mudar o serviço depois não altera compromissos existentes. Sobreposição do
/// mesmo profissional, entre agendamentos ativos, é barrada pelo banco
/// (EXCLUDE em SQL manual na migration).
model ClinicsAppointment {
  id                    String                   @id @default(uuid()) @db.Uuid
  workspaceId           String                   @db.Uuid
  patientId             String                   @db.Uuid
  professionalId        String                   @db.Uuid
  serviceId             String                   @db.Uuid
  unitId                String                   @db.Uuid
  startsAt              DateTime                 @db.Timestamptz(3)
  endsAt                DateTime                 @db.Timestamptz(3)
  status                ClinicsAppointmentStatus @default(scheduled)
  cancelReason          ClinicsCancelReason?
  /// quando a equipe confirmou ESTE horário, pelo relógio do banco (F4.3). Só o
  /// gatilho escreve: na transição para `confirmed`; zerado na volta a
  /// `scheduled` (a remarcação); chegou, atendido e falta não o apagam
  confirmedAt           DateTime?                @db.Timestamptz(3)
  /// `false` só nos agendamentos que já existiam na F4.3 fora de `scheduled`:
  /// a confirmação deles é desconhecida, e nenhuma data é inventada
  confirmationTracked   Boolean                  @default(true)
  createdByMembershipId String                   @db.Uuid
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient            ClinicsPatient             @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  professional       ClinicsProfessional        @relation(fields: [workspaceId, professionalId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  service            ClinicsService             @relation(fields: [workspaceId, serviceId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  unit               ClinicsUnit                @relation(fields: [workspaceId, unitId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy          Membership                 @relation("ClinicsAppointmentCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  attendance         ClinicsAttendance?
  returns            ClinicsReturn[]
  outreach           ClinicsOutreachRequest[]
  dealLink           ClinicsAppointmentDeal?
  /// as correções de consumo do atendimento deste agendamento (ADR-059, F5.2)
  packageCorrections ClinicsPackageCorrection[]

  @@unique([workspaceId, id])
  /// apoio da FK do vínculo do retorno: mesmo paciente, serviço e unidade (F3.2)
  @@unique([workspaceId, id, patientId, serviceId, unitId], map: "ClinicsAppointment_return_link_key")
  @@index([workspaceId, unitId, startsAt])
  @@index([workspaceId, professionalId, startsAt])
  @@index([workspaceId, patientId])
  @@index([workspaceId, serviceId])
  @@index([workspaceId, createdByMembershipId])
}

/// Registro de atendimento (ADR-048 adendo 2, item 5; adendo 4, item 7).
/// Classe S. 1:1 com o agendamento; criado na MESMA transação que o leva a
/// `attended`. Sem texto clínico (H7).
model ClinicsAttendance {
  id                     String   @id @default(uuid()) @db.Uuid
  workspaceId            String   @db.Uuid
  appointmentId          String   @db.Uuid
  professionalId         String   @db.Uuid
  completedAt            DateTime @db.Timestamptz(3)
  recordedByMembershipId String   @db.Uuid
  /// a ESCOLHA feita no registro (ADR-048 adendo 7, F3.1); `null` = avulso.
  /// IMUTÁVEL depois de criado: um trigger do banco recusa a troca. O consumo
  /// que vale é o `currentPackageId` (ADR-059)
  packageId              String?  @db.Uuid
  /// o consumo VIGENTE (ADR-059, F5.2): nasce igual ao `packageId` e só muda
  /// pela inserção de uma `ClinicsPackageCorrection`, pelo gatilho dela. Nunca
  /// escrito pelo Prisma
  currentPackageId       String?  @db.Uuid
  /// a revisão do consumo: 0 no registro, e +1 a cada correção. É o "esperado"
  /// do pedido de correção. Nunca escrita pelo Prisma
  consumptionRevision    Int      @default(0)
  createdAt              DateTime @default(now())
  /// o instante do registro pelo RELÓGIO DO BANCO: a conclusão de um retorno
  /// exige uma prova registrada DEPOIS da criação dele (F3.2). É a exceção ao
  /// ADR-049: `clock_timestamp()`, e não o início da transação, porque o registro
  /// pode esperar a trava do agendamento. Nunca escrito pelo Prisma
  recordedAt             DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointment        ClinicsAppointment         @relation(fields: [workspaceId, appointmentId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  professional       ClinicsProfessional        @relation(fields: [workspaceId, professionalId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  recordedBy         Membership                 @relation("ClinicsAttendanceRecordedBy", fields: [workspaceId, recordedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  package            ClinicsPackage?            @relation("ClinicsAttendancePackage", fields: [workspaceId, packageId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  currentPackage     ClinicsPackage?            @relation("ClinicsAttendanceCurrentPackage", fields: [workspaceId, currentPackageId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  returnsOriginated  ClinicsReturn[]            @relation("ClinicsReturnOrigin")
  returnsFulfilled   ClinicsReturn[]            @relation("ClinicsReturnFulfilledBy")
  packageCorrections ClinicsPackageCorrection[]

  @@unique([workspaceId, appointmentId])
  @@unique([workspaceId, id])
  /// apoio da FK da prova de conclusão do retorno: o registro DESTE agendamento (F3.2)
  @@unique([workspaceId, appointmentId, id], map: "ClinicsAttendance_return_proof_key")
  @@index([workspaceId, professionalId])
  @@index([workspaceId, recordedByMembershipId])
  @@index([workspaceId, packageId])
  /// a contagem do consumo vigente, conferida no COMMIT (ADR-059)
  @@index([workspaceId, currentPackageId])
}

/// Estado do pacote (ADR-048 adendo 7, F3.1). `completed` só pela ÚLTIMA sessão
/// (na mesma instrução do consumo); `canceled` só manual, sem incremento.
enum ClinicsPackageStatus {
  active
  completed
  canceled
}

/// Pacote de sessões (ADR-048 §4 e adendo 7, F3.1). Classe S: liga o paciente a
/// um serviço contratado. Nasce com zero consumidas; paciente, serviço, total,
/// preço e moeda são IMUTÁVEIS (trigger do banco). O CHECK mantém as consumidas
/// no intervalo; a igualdade "consumidas = atendimentos com o consumo VIGENTE
/// neste pacote" é conferida pelo banco no COMMIT (ADR-059). Sem texto livre (H7).
model ClinicsPackage {
  id                    String               @id @default(uuid()) @db.Uuid
  workspaceId           String               @db.Uuid
  patientId             String               @db.Uuid
  serviceId             String               @db.Uuid
  totalSessions         Int
  consumedSessions      Int                  @default(0)
  /// preço TOTAL do pacote, digitado e confirmado; `null` = não informado
  totalPriceCents       Int?
  currency              String
  status                ClinicsPackageStatus @default(active)
  createdByMembershipId String               @db.Uuid
  /// carimbado pelo BANCO na inserção (gatilho, ADR-059): o valor que o Prisma
  /// manda é trocado pelo relógio do banco, em UTC
  createdAt             DateTime             @default(now())
  /// escrito pelo BANCO (trigger), na conclusão ou no cancelamento (ADR-049)
  closedAt              DateTime?            @db.Timestamptz(3)

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient            ClinicsPatient             @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  service            ClinicsService             @relation(fields: [workspaceId, serviceId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy          Membership                 @relation("ClinicsPackageCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  /// os atendimentos que ESCOLHERAM este pacote no registro
  attendances        ClinicsAttendance[]        @relation("ClinicsAttendancePackage")
  /// os atendimentos que o consomem AGORA (o contador conta estes)
  currentAttendances ClinicsAttendance[]        @relation("ClinicsAttendanceCurrentPackage")
  correctionsFrom    ClinicsPackageCorrection[] @relation("ClinicsPackageCorrectionFrom")
  correctionsTo      ClinicsPackageCorrection[] @relation("ClinicsPackageCorrectionTo")
  /// os pagamentos recebidos (ADR-063): lançamentos que não mudam
  payments           ClinicsPackagePayment[]

  @@unique([workspaceId, id])
  /// apoio das FKs da correção: o pacote é do MESMO paciente e serviço (ADR-059)
  @@unique([workspaceId, id, patientId, serviceId], map: "ClinicsPackage_correction_key")
  @@index([workspaceId, patientId])
  @@index([workspaceId, serviceId])
  @@index([workspaceId, createdByMembershipId])
}

/// O motivo de uma correção de consumo (ADR-059, F5.2): lista fechada, sem
/// texto livre (H7).
/// - `wrong_choice`: escolha errada — o pacote errado, o avulso por
///   esquecimento, o pacote por engano, ou uma correção anterior errada;
/// - `package_registered_late`: o pacote foi cadastrado depois do atendimento.
///   Só de avulso para pacote, e só para pacote criado depois do atendimento.
enum ClinicsPackageCorrectionReason {
  wrong_choice
  package_registered_late
}

/// Correção do consumo de um atendimento (ADR-059, F5.2). Classe S, só de
/// acréscimo: o gatilho da inserção confere a revisão e o consumo vigente e
/// os avança no atendimento; nenhuma linha muda depois. O paciente, o serviço
/// e a unidade são os do agendamento (FK composta), e cada pacote referido é do
/// mesmo paciente e serviço. Sem texto livre (H7).
model ClinicsPackageCorrection {
  id                      String                         @id @default(uuid()) @db.Uuid
  workspaceId             String                         @db.Uuid
  attendanceId            String                         @db.Uuid
  appointmentId           String                         @db.Uuid
  patientId               String                         @db.Uuid
  serviceId               String                         @db.Uuid
  unitId                  String                         @db.Uuid
  /// o consumo ANTES; `null` = avulso
  fromPackageId           String?                        @db.Uuid
  /// o consumo DEPOIS; `null` = avulso
  toPackageId             String?                        @db.Uuid
  /// a revisão do consumo que esta correção cria (a anterior + 1)
  revision                Int
  reason                  ClinicsPackageCorrectionReason
  correctedByMembershipId String                         @db.Uuid
  /// pelo relógio do banco (ADR-049); nunca escrito pelo Prisma
  createdAt               DateTime                       @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attendance  ClinicsAttendance  @relation(fields: [workspaceId, appointmentId, attendanceId], references: [workspaceId, appointmentId, id], onDelete: NoAction, onUpdate: NoAction)
  appointment ClinicsAppointment @relation(fields: [workspaceId, appointmentId, patientId, serviceId, unitId], references: [workspaceId, id, patientId, serviceId, unitId], onDelete: NoAction, onUpdate: NoAction)
  fromPackage ClinicsPackage?    @relation("ClinicsPackageCorrectionFrom", fields: [workspaceId, fromPackageId, patientId, serviceId], references: [workspaceId, id, patientId, serviceId], onDelete: NoAction, onUpdate: NoAction)
  toPackage   ClinicsPackage?    @relation("ClinicsPackageCorrectionTo", fields: [workspaceId, toPackageId, patientId, serviceId], references: [workspaceId, id, patientId, serviceId], onDelete: NoAction, onUpdate: NoAction)
  correctedBy Membership         @relation("ClinicsPackageCorrectedBy", fields: [workspaceId, correctedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  /// uma correção por revisão: a corrida perdida falha fechada
  @@unique([workspaceId, attendanceId, revision])
  @@index([workspaceId, appointmentId, patientId, serviceId, unitId])
  @@index([workspaceId, fromPackageId])
  @@index([workspaceId, toPackageId])
  @@index([workspaceId, correctedByMembershipId])
}

/// A forma do recebimento (ADR-063, F6.1): lista fechada, sem texto livre (H7).
enum ClinicsPaymentMethod {
  cash
  pix
  debit_card
  credit_card
  bank_transfer
  other
}

/// O motivo da anulação de um pagamento (ADR-063): lista fechada.
enum ClinicsPaymentVoidReason {
  wrong_entry
  wrong_amount
  duplicate
}

/// Pagamento recebido de um pacote (ADR-063, F6.1; fecha a D1). Classe S, só de
/// acréscimo: um lançamento que não muda nem é apagado (gatilho), corrigido só
/// por anulação. O gatilho da inserção TRAVA o pacote, recusa o pacote
/// cancelado, confere a moeda e não deixa a soma dos não anulados passar do
/// preço registrado; o instante é do banco (ADR-049). Sem texto livre (H7).
model ClinicsPackagePayment {
  id                    String               @id @default(uuid()) @db.Uuid
  workspaceId           String               @db.Uuid
  packageId             String               @db.Uuid
  /// centavos, maior que zero (CHECK), na moeda do pacote
  amountCents           Int
  currency              String
  /// data LOCAL do recebimento na unidade; nunca futura (conferida no serviço)
  receivedOn            DateTime             @db.Date
  method                ClinicsPaymentMethod
  /// a unidade do recebimento (ADR-063 adendo 1): o "hoje" e o fuso. NULL só nos
  /// lançamentos anteriores à F6.1b; o serviço grava em todo pagamento novo
  unitId                String?              @db.Uuid
  createdByMembershipId String               @db.Uuid
  /// pelo relógio do banco (gatilho, ADR-049); nunca escrito pelo Prisma
  createdAt             DateTime             @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  workspace Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  package   ClinicsPackage             @relation(fields: [workspaceId, packageId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  unit      ClinicsUnit?               @relation(fields: [workspaceId, unitId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  createdBy Membership                 @relation("ClinicsPackagePaymentCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  void      ClinicsPackagePaymentVoid?

  @@unique([workspaceId, id])
  @@index([workspaceId, packageId, createdAt])
  @@index([workspaceId, createdByMembershipId])
  @@index([workspaceId, unitId])
}

/// A anulação de um pagamento (ADR-063). No máximo UMA por pagamento (única);
/// o original fica no histórico. Só de acréscimo (gatilho); o gatilho da
/// inserção trava o pacote do pagamento; o instante é do banco.
model ClinicsPackagePaymentVoid {
  id                   String                   @id @default(uuid()) @db.Uuid
  workspaceId          String                   @db.Uuid
  paymentId            String                   @db.Uuid
  reason               ClinicsPaymentVoidReason
  voidedByMembershipId String                   @db.Uuid
  /// pelo relógio do banco (gatilho, ADR-049); nunca escrito pelo Prisma
  createdAt            DateTime                 @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment   ClinicsPackagePayment @relation(fields: [workspaceId, paymentId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  voidedBy  Membership            @relation("ClinicsPackagePaymentVoidedBy", fields: [workspaceId, voidedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  /// uma anulação por pagamento: a segunda falha fechada
  @@unique([workspaceId, paymentId])
  @@index([workspaceId, voidedByMembershipId])
}

/// Retorno (ADR-048 adendo 7, F3.2). Classe S. Concluir é COMPROVAR um
/// atendimento: `done` só com o registro de atendimento do agendamento
/// vinculado (FK composta da prova). Encerrar sem atendimento é cancelar.
enum ClinicsReturnStatus {
  pending
  done
  canceled
}

enum ClinicsReturnCancelReason {
  patient_declined
  patient_unreachable
  not_needed
  created_in_error
}

model ClinicsReturn {
  id                      String                     @id @default(uuid()) @db.Uuid
  workspaceId             String                     @db.Uuid
  patientId               String                     @db.Uuid
  serviceId               String                     @db.Uuid
  unitId                  String                     @db.Uuid
  /// o atendimento que gerou o retorno automático; `null` = criado à mão
  originAttendanceId      String?                    @db.Uuid
  /// data local da unidade
  dueDate                 DateTime                   @db.Date
  status                  ClinicsReturnStatus        @default(pending)
  assigneeMembershipId    String?                    @db.Uuid
  /// o agendamento que vai cumprir (ou cumpriu) o retorno
  appointmentId           String?                    @db.Uuid
  /// a PROVA da conclusão: o registro de atendimento do agendamento vinculado
  fulfilledByAttendanceId String?                    @db.Uuid
  cancelReason            ClinicsReturnCancelReason?
  createdByMembershipId   String                     @db.Uuid
  closedByMembershipId    String?                    @db.Uuid
  /// escrito pelo BANCO: a conclusão exige a prova registrada depois dele (ADR-049)
  createdAt               DateTime                   @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)
  /// escrito pelo BANCO (trigger), na conclusão ou no cancelamento
  closedAt                DateTime?                  @db.Timestamptz(3)

  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient          ClinicsPatient           @relation(fields: [workspaceId, patientId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  service          ClinicsService           @relation(fields: [workspaceId, serviceId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  unit             ClinicsUnit              @relation(fields: [workspaceId, unitId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  originAttendance ClinicsAttendance?       @relation("ClinicsReturnOrigin", fields: [workspaceId, originAttendanceId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsReturn_originAttendance_fkey")
  /// mesmo paciente, serviço e unidade, garantidos pelo banco
  appointment      ClinicsAppointment?      @relation(fields: [workspaceId, appointmentId, patientId, serviceId, unitId], references: [workspaceId, id, patientId, serviceId, unitId], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsReturn_appointment_fkey")
  fulfilledBy      ClinicsAttendance?       @relation("ClinicsReturnFulfilledBy", fields: [workspaceId, appointmentId, fulfilledByAttendanceId], references: [workspaceId, appointmentId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsReturn_fulfilledBy_fkey")
  assignee         Membership?              @relation("ClinicsReturnAssignee", fields: [workspaceId, assigneeMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsReturn_assignee_fkey")
  createdBy        Membership               @relation("ClinicsReturnCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsReturn_createdBy_fkey")
  closedBy         Membership?              @relation("ClinicsReturnClosedBy", fields: [workspaceId, closedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsReturn_closedBy_fkey")
  outreach         ClinicsOutreachRequest[]

  @@unique([workspaceId, id])
  /// um retorno automático por atendimento
  @@unique([workspaceId, originAttendanceId])
  /// um agendamento cumpre no máximo um retorno (o cancelado libera o vínculo)
  @@unique([workspaceId, appointmentId])
  @@index([workspaceId, status, dueDate])
  @@index([workspaceId, patientId])
  @@index([workspaceId, serviceId])
  @@index([workspaceId, unitId])
  @@index([workspaceId, assigneeMembershipId])
  @@index([workspaceId, createdByMembershipId])
  @@index([workspaceId, closedByMembershipId])
}

/// Tipo do pedido de envio (ADR-048 adendos 8 e 9, F4.2).
enum ClinicsOutreachKind {
  confirmation
  reactivation
}

/// Pedido de envio da clínica (ADR-048 adendos 8 e 9, F4.2). Classe S. É a
/// ORIGEM do envio iniciado pelo negócio no Core (`clinics.outreach:<id>`):
/// nasce ANTES da prévia, com o alvo — o agendamento com o início FIXADO
/// (confirmação) ou o retorno (reativação). O canal, o número, a versão e a
/// finalidade ficam na aprovação do Core, e o estado é DERIVADO dela e do
/// despacho. O texto renderizado mora AQUI, e não na mensagem do Core, até o
/// desfecho terminal (a varredura o apaga). A marca de ativo, com o único por
/// alvo, garante no máximo um pedido que conta por alvo; ela só sai quando o
/// pedido é comprovadamente não enviado, sob a `validity:` exclusiva, e nunca
/// volta (gatilho). Sem texto livre de pessoa.
model ClinicsOutreachRequest {
  id                    String              @id @default(uuid()) @db.Uuid
  workspaceId           String              @db.Uuid
  kind                  ClinicsOutreachKind
  /// a confirmação: o agendamento e o início fixado no pedido
  appointmentId         String?             @db.Uuid
  startsAt              DateTime?           @db.Timestamptz(3)
  /// a reativação: o retorno
  returnId              String?             @db.Uuid
  /// `true` enquanto o pedido conta para o alvo; nula quando comprovadamente
  /// não enviado. Nunca `false` (CHECK) e nunca volta a `true` (gatilho)
  activeMark            Boolean?            @default(true)
  /// o texto da prévia, com os valores; apagado no desfecho terminal
  renderedText          String?
  /// quando a varredura apagou o texto (o relógio do banco)
  textClearedAt         DateTime?           @db.Timestamptz(3)
  createdByMembershipId String              @db.Uuid
  /// o relógio do banco: a reativação vale 24 horas a partir daqui
  createdAt             DateTime            @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointment ClinicsAppointment? @relation(fields: [workspaceId, appointmentId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsOutreachRequest_appointment_fkey")
  return      ClinicsReturn?      @relation(fields: [workspaceId, returnId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsOutreachRequest_return_fkey")
  createdBy   Membership          @relation("ClinicsOutreachCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsOutreachRequest_createdBy_fkey")

  @@unique([workspaceId, id])
  /// no máximo um pedido que conta por (agendamento, início): a marca nula não colide
  @@unique([workspaceId, appointmentId, startsAt, activeMark])
  /// no máximo um pedido que conta por retorno
  @@unique([workspaceId, returnId, activeMark])
  @@index([workspaceId, createdByMembershipId])
  /// a varredura do texto pagina por workspace e criação
  @@index([workspaceId, createdAt])
}

/// Vínculo do agendamento com um deal do Core (ADR-048 adendos 8 e 10, F4.3).
/// Classe S: liga o paciente a uma oportunidade. No máximo um deal por
/// agendamento; um deal com vários agendamentos. Vincular, trocar e
/// desvincular só antes do atendimento (gatilho e trava da linha do
/// agendamento). A FK para o deal é `NoAction`: excluir o deal vinculado dá o
/// 409 genérico do Core (V3), e a cascata da exclusão do workspace passa. O
/// vínculo cujo deal mudou de contato fica, mas não é válido nem conta.
model ClinicsAppointmentDeal {
  id                   String   @id @default(uuid()) @db.Uuid
  workspaceId          String   @db.Uuid
  appointmentId        String   @db.Uuid
  dealId               String   @db.Uuid
  linkedByMembershipId String   @db.Uuid
  linkedAt             DateTime @default(dbgenerated("transaction_timestamp()")) @db.Timestamptz(3)

  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointment ClinicsAppointment @relation(fields: [workspaceId, appointmentId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsAppointmentDeal_appointment_fkey")
  deal        Deal               @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsAppointmentDeal_deal_fkey")
  linkedBy    Membership         @relation("ClinicsAppointmentDealLinkedBy", fields: [workspaceId, linkedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction, map: "ClinicsAppointmentDeal_linkedBy_fkey")

  @@unique([workspaceId, id])
  /// no máximo um deal por agendamento
  @@unique([workspaceId, appointmentId])
  @@index([workspaceId, dealId])
  @@index([workspaceId, linkedByMembershipId])
}
