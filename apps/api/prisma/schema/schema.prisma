// Fundação de tenancy (Entrega 1). Convenções: docs/DOMAIN_MODEL.md §1;
// isolamento: docs/SECURITY.md §2; FKs compostas: ADR-010.

generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  suspended
}

enum WorkspaceStatus {
  active
  suspended
}

enum MembershipStatus {
  active
  suspended
  removed
}

// ─── Identidade global (fora do filtro de workspace — SECURITY.md §2) ───────

/// Usuário GLOBAL (ADR-003): sem workspaceId; participa de workspaces via
/// Membership. Acesso sempre via prisma.raw (auth/identidade), justificado.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  name         String
  passwordHash String
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]
}

/// Sessão global (ADR-008): token armazenado só como SHA-256, rotação real.
/// activeMembershipId lembra o workspace ativo entre refreshes; a FK composta
/// (userId, activeMembershipId) → Membership(userId, id) garante NO BANCO que a
/// membership pertence ao dono do token (ADR-018). Nativa no schema (Prisma 7
/// aceita nulidade mista) — a versão em SQL manual foi dropada por um migrate
/// dev e recriada aqui, rastreada; o teste de integração da FK pegou o drift.
model RefreshToken {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenHash          String    @unique
  activeMembershipId String?   @db.Uuid
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership Membership? @relation("SessionActiveMembership", fields: [userId, activeMembershipId], references: [userId, id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, activeMembershipId])
}

/// Raiz do tenant: exclusão LGPD via cascade a partir daqui.
model Workspace {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  slug        String          @unique
  status      WorkspaceStatus @default(active)
  settings    Json            @default("{}")
  /// Região padrão para normalizar telefone sem DDI (ADR-052 item 1, C17).
  /// Não há caminho de mudança: mudar reinterpretaria números existentes, e
  /// isso exige diagnóstico e procedimento explícito (CHECK de duas letras)
  phoneRegion String          @default("BR")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roles                  Role[]
  memberships            Membership[]
  invites                Invite[]
  companies              Company[]
  contacts               Contact[]
  tags                   Tag[]
  customFieldDefinitions CustomFieldDefinition[]
  pipelines              Pipeline[]
  deals                  Deal[]
  tasksList              Task[]
  notes                  Note[]
  activities             Activity[]
  auditLogs              AuditLog[]
  idempotencyKeys        IdempotencyKey[]
  outboxEvents           OutboxEvent[]
  webhooks               Webhook[]
  channels               Channel[]
  conversations          Conversation[]
  messages               Message[]
  calendarEvents         CalendarEvent[]
  notifications          Notification[]
  files                  FileObject[]
  aiRuns                 AiRun[]
  aiProposals            AiProposal[]
  aiConsent              AiConsent?
  subscription           Subscription?
  usageCounters          UsageCounter[]
  usageReservations      UsageReservation[]
  contentUses            ContentUse[]
  automations            Automation[]
  automationExecutions   AutomationExecution[]
  channelCredentials     ChannelCredential[]
  messageTemplates       MessageTemplate[]
  templateVersions       MessageTemplateVersion[]
  templateReviews        TemplateReview[]
  channelConsents        ContactChannelConsent[]
  consentPurposes        ConsentPurpose[]
  consents               Consent[]
  stopBlocks             StopBlock[]
  consentReceiptCounter  ConsentReceiptCounter?
  permissionBackfills    PermissionBackfill[]
  messageDispatches      MessageDispatch[]
  messageStatusEvents    MessageStatusEvent[]
  inboundMedia           InboundMedia[]

  // Lado REVERSO de relações do vertical Clinics (ADR-047 adendo 2, item 1):
  // o Prisma exige os dois lados e um modelo não se divide entre arquivos. Só
  // tipo de campo reverso — a FK mora no arquivo do vertical; o código do Core
  // não importa nada dele (lint + teste de fronteira + teste deste arquivo).
  clinicsSettings             ClinicsSettings?
  clinicsUnits                ClinicsUnit[]
  clinicsContactReleases      ClinicsContactRelease[]
  clinicsServices             ClinicsService[]
  clinicsProfessionals        ClinicsProfessional[]
  clinicsProfessionalServices ClinicsProfessionalService[]
  clinicsWorkingHours         ClinicsWorkingHours[]
  clinicsPatients             ClinicsPatient[]
  clinicsAppointments         ClinicsAppointment[]
  clinicsAttendances          ClinicsAttendance[]
  clinicsPackages             ClinicsPackage[]
  clinicsReturns              ClinicsReturn[]
}

/// Catálogo GLOBAL de permissões (ADR-004): chaves estáveis do sistema —
/// exceção documentada à regra do workspaceId (é catálogo, não dado de tenant).
model Permission {
  key         String @id
  description String

  rolePermissions RolePermission[]
  backfills       PermissionBackfill[]
}

// ─── Dados de acesso por workspace (tenant-scoped, em WORKSPACE_MODELS) ─────

/// Role SEMPRE pertence a um workspace (ADR-004); padrões semeados no
/// provisionamento com isSystem=true. Não existe Role global.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false)
  /// Papel de SISTEMA identificado por chave estável ('owner'|'admin'|'member'|
  /// 'guest'), não por nome (ADR-004/017): invariantes de ciclo de vida (último
  /// Owner) ramificam por systemKey; null para papéis customizados. Extensões
  /// criam os seus com prefixo próprio ('<extensão>:<papel>'), só pela CLI de
  /// ativação (ADR-047).
  systemKey   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]
  invites     Invite[]
  backfills   PermissionBackfill[]

  // Alvo de FK composta (ADR-010): quem referencia Role referencia (workspaceId, id)
  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@unique([workspaceId, systemKey])
}

/// Junção Role↔Permission, tenant-scoped.
model RolePermission {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @db.Uuid
  roleId        String @db.Uuid
  permissionKey String

  // FK composta: impede vincular permissão a role de OUTRO workspace no banco
  role       Role       @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@unique([workspaceId, roleId, permissionKey])
  @@index([workspaceId, roleId])
}

/// Ponte User↔Workspace (ADR-003), tenant-scoped. tokenVersion viaja no JWT e
/// invalida sessões quando a membership muda (ADR-009).
model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @db.Uuid
  userId       String           @db.Uuid
  roleId       String           @db.Uuid
  status       MembershipStatus @default(active)
  tokenVersion Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // FK composta (ADR-010): Membership não pode apontar para Role de outro workspace
  role      Role      @relation(fields: [workspaceId, roleId], references: [workspaceId, id])

  ownedCompanies             Company[]               @relation("CompanyOwner")
  ownedContacts              Contact[]               @relation("ContactOwner")
  activeSessions             RefreshToken[]          @relation("SessionActiveMembership")
  ownedDeals                 Deal[]                  @relation("DealOwner")
  assignedTasks              Task[]                  @relation("TaskAssignee")
  authoredNotes              Note[]                  @relation("NoteAuthor")
  activities                 Activity[]              @relation("ActivityActor")
  auditLogs                  AuditLog[]              @relation("AuditActor")
  assignedConversations      Conversation[]          @relation("ConversationAssignee")
  authoredMessages           Message[]               @relation("MessageAuthorMembership")
  organizedEvents            CalendarEvent[]         @relation("EventOrganizer")
  notifications              Notification[]          @relation("NotificationRecipient")
  uploadedFiles              FileObject[]            @relation("FileUploader")
  aiRuns                     AiRun[]                 @relation("AiRunTrigger")
  reviewedProposals          AiProposal[]            @relation("ProposalReviewer")
  consentChanges             AiConsent[]             @relation("ConsentAuthor")
  grantedConsents            ContactChannelConsent[] @relation("ConsentGranter")
  purposeConsentsGranted     Consent[]               @relation("PurposeConsentGrantedBy")
  templateReviews            TemplateReview[]
  purposeConsentsRevoked     Consent[]               @relation("PurposeConsentRevokedBy")
  stopBlocksCreated          StopBlock[]             @relation("StopBlockCreatedBy")
  stopBlocksLifted           StopBlock[]             @relation("StopBlockLiftedBy")
  // lado reverso do vertical Clinics (ADR-047 adendo 2, item 1)
  clinicsReleasesGranted     ClinicsContactRelease[] @relation("ClinicsReleaseGrantedBy")
  clinicsProfessional        ClinicsProfessional?    @relation("ClinicsProfessionalAccount")
  clinicsPatientsCreated     ClinicsPatient[]        @relation("ClinicsPatientCreatedBy")
  clinicsAppointmentsCreated ClinicsAppointment[]    @relation("ClinicsAppointmentCreatedBy")
  clinicsAttendancesRecorded ClinicsAttendance[]     @relation("ClinicsAttendanceRecordedBy")
  clinicsPackagesCreated     ClinicsPackage[]        @relation("ClinicsPackageCreatedBy")
  clinicsReturnsAssigned     ClinicsReturn[]         @relation("ClinicsReturnAssignee")
  clinicsReturnsCreated      ClinicsReturn[]         @relation("ClinicsReturnCreatedBy")
  clinicsReturnsClosed       ClinicsReturn[]         @relation("ClinicsReturnClosedBy")

  // Alvo de FK composta para Team/ownership futuros
  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  // Alvo da FK composta de RefreshToken (userId, activeMembershipId): o banco
  // garante que o workspace ativo de uma sessão pertence ao dono da sessão
  @@unique([userId, id])
  @@index([workspaceId, roleId])
  @@index([userId])
}

/// Convite: a porta de entrada sem registro público (ADR-014).
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  email       String
  roleId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, email])
  // custo do ON DELETE CASCADE da FK composta (exclusão de Role varre Invite)
  @@index([workspaceId, roleId])
}

// ─── CRM: relacionamento (Entrega 3) ─────────────────────────────────────────

enum ContactStatus {
  active
  archived
}

enum CompanySize {
  solo
  small
  medium
  large
  enterprise
}

enum TagColor {
  slate
  stone
  accent
  positive
  negative
  warning
  info
}

enum CustomFieldEntity {
  contact
  company
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multiselect
}

model Company {
  id                String       @id @default(uuid()) @db.Uuid
  workspaceId       String       @db.Uuid
  name              String
  domain            String?
  size              CompanySize?
  ownerMembershipId String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK composta com nulidade mista (MATCH SIMPLE ignora quando NULL).
  // NoAction ≠ Restrict: a checagem ocorre ao FIM do statement (não imediata),
  // o que deixa o cascade do Workspace concluir. NÃO é DEFERRABLE (não adia ao
  // commit) — comportamento coberto pelo teste de exclusão de workspace.
  // SET NULL anularia TODAS as colunas da FK, inclusive workspaceId — proibido.
  owner      Membership?  @relation("CompanyOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contacts   Contact[]
  tags       CompanyTag[]
  deals      Deal[]
  notes      Note[]
  activities Activity[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, domain])
  @@index([workspaceId, name])
}

model Contact {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  name              String
  emails            String[]      @default([])
  phones            String[]      @default([])
  /// Formas E.164 VÁLIDAS dos telefones, pela região do workspace (ADR-052
  /// item 1). O original fica em `phones`; número que não se valida não entra
  /// aqui e nada é completado. Recalculada pelo serviço em toda escrita
  phonesNormalized  String[]      @default([])
  /// A chave de coincidência: os últimos 8 dígitos de cada telefone com 8 ou
  /// mais dígitos, normalizado ou não. É por ela que a ingestão acha os
  /// candidatos (o número exato, a variante do 9º dígito e o sufixo)
  phoneMatchKeys    String[]      @default([])
  status            ContactStatus @default(active)
  companyId         String?       @db.Uuid
  ownerMembershipId String?       @db.Uuid
  source            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company    Company?     @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  owner      Membership?  @relation("ContactOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  tags       ContactTag[]
  deals      Deal[]
  tasksList  Task[]
  notes      Note[]
  activities Activity[]

  conversations          Conversation[]
  messages               Message[]               @relation("MessageAuthorContact")
  calendarEvents         CalendarEvent[]
  aiProposals            AiProposal[]
  aiRuns                 AiRun[]
  contactChannelConsents ContactChannelConsent[]
  consents               Consent[]
  // lado reverso do vertical Clinics (ADR-047 adendo 2, item 1)
  clinicsContactReleases ClinicsContactRelease[]
  clinicsPatient         ClinicsPatient?

  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, name])
  @@index([workspaceId, companyId])
  @@index([workspaceId, ownerMembershipId])
  // GIN sobre o array, sem o workspaceId na frente: um GIN composto com uuid
  // exigiria a extensão btree_gin. A consulta filtra o workspace depois
  @@index([phoneMatchKeys], type: Gin)
}

model Tag {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  color       TagColor @default(slate)
  createdAt   DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]
  companyTags CompanyTag[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

model ContactTag {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  contactId   String @db.Uuid
  tagId       String @db.Uuid

  contact Contact @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, contactId, tagId])
  @@index([workspaceId, tagId])
}

model CompanyTag {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @db.Uuid
  companyId   String @db.Uuid
  tagId       String @db.Uuid

  company Company @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  tag     Tag     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, companyId, tagId])
  @@index([workspaceId, tagId])
}

model CustomFieldDefinition {
  id          String            @id @default(uuid()) @db.Uuid
  workspaceId String            @db.Uuid
  entityType  CustomFieldEntity
  /// chave estável (snake_case) usada nas APIs — imutável após criada
  key         String
  label       String
  type        CustomFieldType
  options     String[]          @default([])
  required    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, entityType, key])
}

/// Valor tipado pela definição. `entityId` NÃO tem FK — exceção documentada
/// (DOMAIN_MODEL §9): tenant-scoped, não navegável; a limpeza é responsabilidade
/// do service que exclui a entidade (delete de contato/empresa apaga os values).
model CustomFieldValue {
  id           String            @id @default(uuid()) @db.Uuid
  workspaceId  String            @db.Uuid
  definitionId String            @db.Uuid
  entityType   CustomFieldEntity
  entityId     String            @db.Uuid
  value        Json

  definition CustomFieldDefinition @relation(fields: [workspaceId, definitionId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, definitionId, entityId])
  @@index([workspaceId, entityType, entityId])
}

// ─── CRM: vendas e trabalho (Entrega 4) ──────────────────────────────────────

enum StageType {
  open
  won
  lost
}

enum DealStatus {
  open
  won
  lost
}

enum TaskStatus {
  open
  done
}

enum TaskPriority {
  low
  normal
  high
}

enum ActivityType {
  contact_created
  deal_created
  deal_stage_changed
  deal_updated
  deal_won
  deal_lost
  task_created
  task_completed
  note_added
  note_deleted
  message_sent
  message_received
  event_scheduled
}

enum ActivityActor {
  user
  system
  /// mutação EXECUTADA pela IA a partir de proposta aprovada — o aprovador
  /// fica em actorMembershipId como contexto, mas o ator é a IA
  ai
}

model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  /// Unique parcial ESTRUTURAL (ajuste #2): TRUE ou NULL, nunca false — o
  /// @@unique([workspaceId, defaultMark]) garante no banco um só default por
  /// workspace (NULLs não colidem), sem SQL manual e sem risco de drift.
  defaultMark Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@unique([workspaceId, defaultMark])
}

model Stage {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  pipelineId  String    @db.Uuid
  name        String
  order       Int
  probability Int?
  type        StageType @default(open)

  pipeline Pipeline @relation(fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: Cascade)
  deals    Deal[]

  @@unique([workspaceId, id])
  // Alvo da FK TRIPLA do Deal (ajuste #1): o banco garante stage∈pipeline
  @@unique([workspaceId, pipelineId, id])
  @@unique([workspaceId, pipelineId, name])
  @@index([workspaceId, pipelineId, order])
}

model Deal {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @db.Uuid
  pipelineId        String     @db.Uuid
  stageId           String     @db.Uuid
  title             String
  contactId         String?    @db.Uuid
  companyId         String?    @db.Uuid
  ownerMembershipId String?    @db.Uuid
  amountCents       Int        @default(0)
  currency          String     @default("BRL")
  expectedCloseDate DateTime?
  status            DealStatus @default(open)
  /// ordenação na coluna do kanban (gaps de 1024, rebalanceado sob lock)
  position          Int
  /// atualizado ao mover de stage — insumo do "oportunidade parada" (E7)
  stageEnteredAt    DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline    @relation(fields: [workspaceId, pipelineId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  // FK TRIPLA (ajuste #1): stage do MESMO pipeline, garantido no banco —
  // deal com pipelineId de A e stageId de B é violação de FK, não bug de service
  stage     Stage       @relation(fields: [workspaceId, pipelineId, stageId], references: [workspaceId, pipelineId, id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact?    @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  company   Company?    @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  owner     Membership? @relation("DealOwner", fields: [workspaceId, ownerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  calendarEvents CalendarEvent[]
  aiProposals    AiProposal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, pipelineId, stageId, position])
  @@index([workspaceId, contactId])
  @@index([workspaceId, companyId])
  @@index([workspaceId, ownerMembershipId])
  @@index([workspaceId, status])
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  workspaceId          String       @db.Uuid
  title                String
  description          String?
  dueAt                DateTime?
  assigneeMembershipId String?      @db.Uuid
  status               TaskStatus   @default(open)
  priority             TaskPriority @default(normal)
  contactId            String?      @db.Uuid
  dealId               String?      @db.Uuid
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee  Membership? @relation("TaskAssignee", fields: [workspaceId, assigneeMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact?    @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  deal      Deal?       @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)

  activities Activity[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, assigneeMembershipId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
}

model Note {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  body               String
  authorMembershipId String   @db.Uuid
  contactId          String?  @db.Uuid
  companyId          String?  @db.Uuid
  dealId             String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    Membership @relation("NoteAuthor", fields: [workspaceId, authorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact   Contact?   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  company   Company?   @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  deal      Deal?      @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, contactId, createdAt])
  @@index([workspaceId, companyId])
  @@index([workspaceId, dealId, createdAt])
  @@index([workspaceId, authorMembershipId])
}

/// Timeline (ADR-011): APPEND-ONLY, sem API de escrita — só ActivitiesService
/// emite, com payload validado por mapa fechado ActivityType→Zod (ajuste #4).
/// Referências por FKs EXPLÍCITAS compostas, com Cascade: o histórico morre com
/// a entidade (LGPD) — nunca par genérico entityType/entityId.
model Activity {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @db.Uuid
  type              ActivityType
  actorType         ActivityActor @default(user)
  actorMembershipId String?       @db.Uuid
  payload           Json
  occurredAt        DateTime      @default(now())
  contactId         String?       @db.Uuid
  companyId         String?       @db.Uuid
  dealId            String?       @db.Uuid
  taskId            String?       @db.Uuid
  conversationId    String?       @db.Uuid
  calendarEventId   String?       @db.Uuid

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor         Membership?    @relation("ActivityActor", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact       Contact?       @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  company       Company?       @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Cascade)
  deal          Deal?          @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  task          Task?          @relation(fields: [workspaceId, taskId], references: [workspaceId, id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [workspaceId, calendarEventId], references: [workspaceId, id], onDelete: Cascade)

  // cursor keyset (occurredAt, id) por alvo — paginação estável (ajuste #5)
  @@index([workspaceId, contactId, occurredAt(sort: Desc), id])
  @@index([workspaceId, dealId, occurredAt(sort: Desc), id])
  @@index([workspaceId, conversationId, occurredAt(sort: Desc), id])
}

// ─── Plataforma de confiança (Entrega 5) ─────────────────────────────────────

enum AuditActor {
  user
  api
  system
  ai
}

/// Trilha de auditoria: APPEND-ONLY (bloqueado no PrismaService) e MINIMIZADA —
/// before/after passam por allowlist de campos por entidade, com redaction
/// (SECURITY.md §5). Retenção de 12 meses via job (prisma.raw justificado).
model AuditLog {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @db.Uuid
  actorType         AuditActor @default(user)
  /// membership do ator quando é usuário do workspace (FK composta)
  actorMembershipId String?    @db.Uuid
  /// identificador da ORIGEM quando não é usuário: id da API key, nome do job,
  /// serviço ou AiRun (ajuste #2) — actorMembershipId não serve para esses casos
  actorId           String?
  action            String
  entityType        String
  entityId          String     @db.Uuid
  before            Json?
  after             Json?
  requestId         String?
  createdAt         DateTime   @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     Membership? @relation("AuditActor", fields: [workspaceId, actorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workspaceId, entityType, entityId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc), id])
}

enum IdempotencyState {
  processing
  completed
}

/// Idempotência HTTP com RESERVA ATÔMICA (ajuste #3): a chave é reservada como
/// `processing` ANTES de executar; dois requests idênticos concorrentes não
/// executam duas vezes. requestHash cobre método + rota canônica + params +
/// body normalizado. 5xx/rollback liberam a reserva (linha é apagada).
model IdempotencyKey {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  key            String
  endpoint       String
  requestHash    String
  state          IdempotencyState @default(processing)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, endpoint])
  @@index([expiresAt])
}

enum OutboxStatus {
  pending
  /// reivindicado por um worker: invisível para os demais até o lease expirar
  processing
  delivered
  failed
  dead
}

/// Outbox transacional: o efeito externo é gravado na MESMA transação do
/// domínio e entregue depois pelo worker — nunca escapa se a transação abortar.
model OutboxEvent {
  id                 String       @id @default(uuid()) @db.Uuid
  workspaceId        String       @db.Uuid
  eventType          String
  payload            Json
  dedupeKey          String
  status             OutboxStatus @default(pending)
  attempts           Int          @default(0)
  /// Nasce pelo DEFAULT do BANCO (ADR-049): o claim compara com `now()`, e o
  /// `@default(now())` do Prisma usaria o relógio do Node.
  nextRetryAt        DateTime     @default(dbgenerated("transaction_timestamp()"))
  /// LEASE: quando o worker reivindicou e até quando o claim vale. Worker que
  /// morre no meio libera o evento pela expiração — sem lease, o `SKIP LOCKED`
  /// só protege durante o UPDATE e outra instância entregaria em paralelo.
  claimedAt          DateTime?
  leaseExpiresAt     DateTime?
  /// FENCING TOKEN: identifica QUEM detém o lease atual. Sem ele, um worker
  /// lento que perdeu o lease por expiração ainda conseguiria marcar o evento
  /// como delivered, sobrescrevendo o trabalho de quem o reivindicou depois.
  claimToken         String?      @db.Uuid
  lastError          String?
  deliveredAt        DateTime?
  /// CAUSALIDADE (ADR-035) em COLUNAS, nunca no payload: payload é o que sai
  /// para webhook de cliente, e a topologia interna de automação não é assunto
  /// dele. `chainId` é a raiz da cadeia; `depth` cresce a cada elo.
  chainId            String?      @db.Uuid
  depth              Int          @default(0)
  originAutomationId String?      @db.Uuid
  /// FOTOGRAFIA dos contatos de quem era o evento NA EMISSÃO (ADR-047 adendo 2):
  /// a entrega a soma à resolução do momento, então um deal desligado do contato
  /// entre emitir e entregar não escapa da restrição de conteúdo. SEM FK de
  /// propósito — contato excluído depois não apaga nem bloqueia o evento — e por
  /// isso o isolamento é conferido no `enqueue` (mesmo workspace, mesma
  /// transação). NULL = evento interno ou anterior a esta coluna.
  subjectContactIds  String[]     @db.Uuid
  createdAt          DateTime     @default(now())

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries       WebhookDelivery[]
  // FK composta com NoAction: excluir uma automação NÃO pode levar eventos de
  // domínio embora, então o service anula esta coluna antes de excluí-la
  originAutomation Automation?           @relation(fields: [workspaceId, originAutomationId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  /// a raiz da cadeia é um evento REAL: auto-referência composta em vez de um
  /// id solto de correlação (o check:fk cobrou isso, com razão)
  chain            OutboxEvent?          @relation("OutboxChain", fields: [workspaceId, chainId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  chainedEvents    OutboxEvent[]         @relation("OutboxChain")
  executions       AutomationExecution[]

  @@unique([workspaceId, dedupeKey])
  @@unique([workspaceId, id])
  @@index([status, nextRetryAt])
  @@index([status, leaseExpiresAt])
}

enum WebhookStatus {
  active
  paused
  disabled
}

model Webhook {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @db.Uuid
  url          String
  events       String[]      @default([])
  /// segredo HMAC cifrado (AES-256-GCM) — JAMAIS em DTO, log ou auditoria
  secretCipher String
  status       WebhookStatus @default(active)
  /// conta ENTREGAS MORTAS consecutivas (ajuste #7), não tentativas
  failureCount Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

/// Histórico de entrega (ajuste #4): FKs COMPOSTAS para Webhook e OutboxEvent,
/// com unicidade por tentativa — o banco impede registro cross-workspace e
/// duplicidade de tentativa.
model WebhookDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @db.Uuid
  webhookId      String   @db.Uuid
  outboxEventId  String   @db.Uuid
  attempt        Int
  responseStatus Int?
  error          String?
  durationMs     Int
  createdAt      DateTime @default(now())

  webhook     Webhook     @relation(fields: [workspaceId, webhookId], references: [workspaceId, id], onDelete: Cascade)
  outboxEvent OutboxEvent @relation(fields: [workspaceId, outboxEventId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, webhookId, outboxEventId, attempt])
  @@index([workspaceId, webhookId, createdAt(sort: Desc)])
}

// ─── Comunicação (Entrega 6.1) ────────────────────────────────────────────────

/// Canal de comunicação. `email`/`whatsapp` estão reservados no enum, mas a API
/// desta entrega aceita SOMENTE `internal` (ADR-023).
enum ChannelType {
  internal
  email
  whatsapp
}

enum ConversationStatus {
  open
  pending
  closed
}

/// O remetente da conversa (ADR-052 item 2): `unidentified` é o "remetente a
/// identificar" (RAI), sempre SEM contato, que nenhum caminho atribui sozinho
enum ConversationSender {
  identified
  unidentified
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageAuthor {
  contact
  user
  ai
  system
}

model Channel {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid
  type        ChannelType
  name        String
  /// EXATAMENTE UM canal interno por workspace, garantido pelo banco: TRUE ou
  /// NULL + unique composto (mesmo padrão de `Pipeline.defaultMark`). Nenhum
  /// service precisa se lembrar da invariante.
  systemMark  Boolean?
  createdAt   DateTime    @default(now())

  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  messages         Message[]
  credential       ChannelCredential?
  messageTemplates MessageTemplate[]
  templateVersions MessageTemplateVersion[]
  consents         Consent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, systemMark])
  @@index([workspaceId, type])
}

model Conversation {
  id                   String             @id @default(uuid()) @db.Uuid
  workspaceId          String             @db.Uuid
  channelId            String             @db.Uuid
  contactId            String?            @db.Uuid
  subject              String?
  status               ConversationStatus @default(open)
  assigneeMembershipId String?            @db.Uuid
  /// SEMPRE preenchido (default now() na criação): o keyset do inbox não tem
  /// caso especial de null.
  lastMessageAt        DateTime           @default(now())
  /// Última mensagem DO CONTATO: define a janela de atendimento de 24h
  /// (ADR-038). Não é consentimento — este é evidência separada.
  lastInboundAt        DateTime?
  /// ENDEREÇO EXATO no canal externo (E.164 do wa_id que entrou). Um contato
  /// pode ter vários telefones; o envio NÃO escolhe um de `Contact.phones` —
  /// responde para o número que falou com a gente.
  externalAddress      String?
  /// RAI (ADR-052 item 2): o CHECK garante que `unidentified` não tem contato
  senderStatus         ConversationSender @default(identified)
  /// quando uma PESSOA identificou o remetente de uma conversa que nasceu RAI;
  /// null nas atribuídas pela ingestão. É o que separa desfazer de rejeitar
  senderIdentifiedAt   DateTime?
  /// marca do único "uma conversa aberta por (canal, contato, número)": TRUE
  /// fora de `closed`, NULL encerrada. Mantida por gatilho no banco
  openMark             Boolean?
  /// marca do único "uma RAI aberta por (canal, número)": TRUE na RAI fora de
  /// `closed`, NULL no resto. Mantida pelo mesmo gatilho
  unidentifiedOpenMark Boolean?
  createdAt            DateTime           @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel      @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  assignee    Membership?  @relation("ConversationAssignee", fields: [workspaceId, assigneeMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  messages    Message[]
  activities  Activity[]
  aiProposals AiProposal[]
  aiRuns      AiRun[]

  @@unique([workspaceId, id])
  // alvo da FK TRIPLA de Message: o banco garante que a mensagem não pode
  // apontar para a conversa A usando o canal B (mesma classe da FK tripla
  // Deal→Stage, ADR-010)
  @@unique([workspaceId, channelId, id])
  // ADR-052 item 2: uma conversa aberta por (canal, contato, número) e uma RAI
  // aberta por (canal, número). NULL não colide, então a marca NULL (encerrada)
  // e o contato ou o número ausentes ficam fora da unicidade
  @@unique([workspaceId, channelId, contactId, externalAddress, openMark])
  @@unique([workspaceId, channelId, externalAddress, unidentifiedOpenMark])
  // cursor keyset do inbox: (lastMessageAt, id) desc, por status
  @@index([workspaceId, status, lastMessageAt(sort: Desc), id])
  @@index([workspaceId, lastMessageAt(sort: Desc), id])
  @@index([workspaceId, contactId])
  @@index([workspaceId, assigneeMembershipId])
}

model Message {
  id                 String           @id @default(uuid()) @db.Uuid
  workspaceId        String           @db.Uuid
  conversationId     String           @db.Uuid
  /// derivado da conversa NO SERVIDOR (nunca do cliente) — existe para o unique
  /// de dedup de ingestão externa, que é por canal
  channelId          String           @db.Uuid
  direction          MessageDirection
  authorType         MessageAuthor
  authorMembershipId String?          @db.Uuid
  authorContactId    String?          @db.Uuid
  body               String
  externalId         String?
  deliveredAt        DateTime?
  createdAt          DateTime         @default(now())

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK TRIPLA: canal da mensagem = canal da conversa, garantido pelo banco
  conversation        Conversation         @relation(fields: [workspaceId, channelId, conversationId], references: [workspaceId, channelId, id], onDelete: Cascade)
  channel             Channel              @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  authorMembership    Membership?          @relation("MessageAuthorMembership", fields: [workspaceId, authorMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  authorContact       Contact?             @relation("MessageAuthorContact", fields: [workspaceId, authorContactId], references: [workspaceId, id], onDelete: Cascade)
  attachments         MessageAttachment[]
  messageDispatches   MessageDispatch[]
  messageStatusEvents MessageStatusEvent[]
  inboundMedias       InboundMedia[]

  @@unique([workspaceId, id])
  // dedup de ingestão externa (nulos não colidem: mensagem interna não tem externalId)
  @@unique([workspaceId, channelId, externalId])
  @@index([workspaceId, conversationId, createdAt(sort: Desc), id])
}

// ─── Organização: agenda e notificações (Entrega 6.2) ─────────────────────────

enum CalendarEventStatus {
  scheduled
  done
  canceled
}

model CalendarEvent {
  id                    String              @id @default(uuid()) @db.Uuid
  workspaceId           String              @db.Uuid
  title                 String
  description           String?
  /// CHECK "endAt" > "startAt" no banco: invariante de tempo não depende do
  /// service (migration 20260820190000_calendar_notifications)
  startAt               DateTime
  endAt                 DateTime
  location              String?
  status                CalendarEventStatus @default(scheduled)
  organizerMembershipId String              @db.Uuid
  contactId             String?             @db.Uuid
  dealId                String?             @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  organizer  Membership @relation("EventOrganizer", fields: [workspaceId, organizerMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  contact    Contact?   @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  deal       Deal?      @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  activities Activity[]

  @@unique([workspaceId, id])
  // agenda é sempre consultada por janela de tempo
  @@index([workspaceId, startAt])
  @@index([workspaceId, organizerMembershipId, startAt])
  @@index([workspaceId, contactId])
  @@index([workspaceId, dealId])
}

/// Notificação PESSOAL: sempre lida pelo próprio destinatário. `dedupeKey`
/// torna a emissão idempotente — retry do mesmo fato não gera segunda notificação.
model Notification {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @db.Uuid
  recipientMembershipId String    @db.Uuid
  type                  String
  payload               Json
  dedupeKey             String
  readAt                DateTime?
  createdAt             DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient Membership @relation("NotificationRecipient", fields: [workspaceId, recipientMembershipId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, dedupeKey])
  // caixa pessoal: não lidas primeiro, mais recentes no topo
  @@index([workspaceId, recipientMembershipId, readAt, createdAt(sort: Desc)])
}

// ─── Arquivos (Entrega 6.3) ───────────────────────────────────────────────────

/// pending → nunca saiu para canal externo; clean → liberado; quarantined →
/// nem download interno. Marcar clean exige scanner real (SECURITY.md §7.5).
enum FileScanStatus {
  pending
  clean
  quarantined
}

model FileObject {
  id                     String         @id @default(uuid()) @db.Uuid
  workspaceId            String         @db.Uuid
  /// chave no storage, SEMPRE derivada no servidor: {workspaceId}/{uuid}{ext}
  key                    String
  fileName               String
  /// MIME DETECTADO por magic bytes — nunca o declarado pelo cliente (ADR-025)
  mimeType               String
  sizeBytes              Int
  uploadedByMembershipId String         @db.Uuid
  scanStatus             FileScanStatus @default(pending)
  /// instante do VEREDITO do scanner; null = ainda não verificado
  scannedAt              DateTime?
  /// código curto do scanner (nome da ameaça ou motivo da falha) — nunca saída bruta
  scanError              String?
  scanAttempts           Int            @default(0)
  /// LEASE + FENCING da varredura: ler bytes e escanear leva tempo, e dois
  /// workers no mesmo arquivo desperdiçariam trabalho e embaralhariam o estado
  scanClaimToken         String?        @db.Uuid
  scanLeaseExpiresAt     DateTime?
  /**
   * Instante em que os bytes SAÍRAM do storage, gravado só com confirmação do
   * driver (ADR-043). Para `quarantined`, null significa "malware ainda no
   * disco" — pendência de limpeza que um job idempotente retenta. Nunca volta
   * o arquivo para `pending` nem apaga a linha.
   */
  bytesPurgedAt          DateTime?
  /// A REGRA DOS ANEXOS DE CONVERSA vale mesmo sem vínculo (ADR-052, decisão de
  /// 2026-10-23): marcada na quarentena que a exclusão de um contato preserva
  /// como evidência (ADR-043 §4). A linha fica, com o nome original, mas só
  /// quem lê conversas a vê — nunca quem só tem `files:read`.
  conversationRestricted Boolean        @default(false)
  createdAt              DateTime       @default(now())

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy    Membership          @relation("FileUploader", fields: [workspaceId, uploadedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  attachments   MessageAttachment[]
  inboundMedias InboundMedia[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, scanStatus])
  // varredura e limpeza são CROSS-WORKSPACE: os índices não lideram por workspace
  @@index([scanStatus, scanLeaseExpiresAt])
  @@index([scanStatus, bytesPurgedAt])
}

/// Anexo de mensagem: as DUAS pontas em FK composta — anexo não alcança
/// mensagem nem arquivo de outro workspace.
model MessageAttachment {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @db.Uuid
  messageId    String @db.Uuid
  fileObjectId String @db.Uuid

  message Message    @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)
  file    FileObject @relation(fields: [workspaceId, fileObjectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, messageId, fileObjectId])
  @@index([workspaceId, fileObjectId])
}

// ─── Inteligência (Entrega 7) ─────────────────────────────────────────────────

enum AiRunStatus {
  ok
  refused
  error
  /// o uso externo ficou em dúvida (ADR-047 adendo 7): a chamada pode ter
  /// começado; o resultado foi descartado e as reservas, cobradas pelo teto
  unknown_after_dispatch
}

enum AiRunAction {
  none
  proposed
  executed
}

enum AiProposalStatus {
  pending
  /// estado TRANSITÓRIO: reivindicada e em execução dentro da transação.
  /// Se a transação falhar, o rollback devolve a linha para `pending`.
  executing
  approved
  rejected
  expired
}

/// Tipos de proposta PERMITIDOS. O modelo não inventa tipo: a saída é validada
/// contra esta lista e contra o schema Zod estrito do payload (ADR-029).
enum AiProposalType {
  create_task
  /// rascunho de resposta em conversa; aprovar delega ao envio (ADR-044)
  send_message
}

/// Catálogo GLOBAL de prompts versionados (como Permission): mudar prompt é
/// versão nova, nunca edição silenciosa. Não é dado de tenant.
model PromptVersion {
  id         String   @id @default(uuid()) @db.Uuid
  capability String
  version    Int
  /// sha256 do texto do prompt — detecta edição sem bump de versão
  hash       String
  changelog  String
  createdAt  DateTime @default(now())

  runs AiRun[]

  @@unique([capability, version])
}

model AiRun {
  id                      String      @id @default(uuid()) @db.Uuid
  workspaceId             String      @db.Uuid
  capability              String
  promptVersionId         String?     @db.Uuid
  model                   String
  /// DESCRIÇÃO do contexto (quais entidades/campos), NUNCA o payload bruto,
  /// corpo de mensagem, prompt ou segredo — vale também para runs com erro
  contextSummary          String
  status                  AiRunStatus
  /// código curto do motivo (ex.: 'no_consent', 'invalid_output', 'provider_error');
  /// jamais stack trace ou mensagem do provedor
  reasonCode              String?
  inputTokens             Int         @default(0)
  outputTokens            Int         @default(0)
  costCents               Int         @default(0)
  latencyMs               Int         @default(0)
  action                  AiRunAction @default(none)
  /// RESULTADO estruturado e validado (allowlist por capacidade): é o que torna
  /// o insight reutilizável na interface. Nunca prompt, corpo bruto ou segredo.
  result                  Json?
  /// alvo do run, em colunas FK tipadas — nunca polimorfismo solto
  conversationId          String?     @db.Uuid
  contactId               String?     @db.Uuid
  triggeredByMembershipId String?     @db.Uuid
  createdAt               DateTime    @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id])
  triggeredBy   Membership?    @relation("AiRunTrigger", fields: [workspaceId, triggeredByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  conversation  Conversation?  @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  proposals     AiProposal[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, capability, createdAt(sort: Desc)])
  // último resultado por alvo: é assim que a interface reaproveita o insight
  @@index([workspaceId, conversationId, capability, createdAt(sort: Desc)])
  @@index([workspaceId, contactId, capability, createdAt(sort: Desc)])
}

/// Ação externa proposta pela IA: só existe executada DEPOIS de aprovação
/// humana (princípio 4). Alvos por colunas FK tipadas — nunca polimorfismo solto.
model AiProposal {
  id                     String           @id @default(uuid()) @db.Uuid
  workspaceId            String           @db.Uuid
  runId                  String           @db.Uuid
  type                   AiProposalType
  payload                Json
  rationale              String
  status                 AiProposalStatus @default(pending)
  contactId              String?          @db.Uuid
  dealId                 String?          @db.Uuid
  conversationId         String?          @db.Uuid
  reviewedByMembershipId String?          @db.Uuid
  reviewedAt             DateTime?
  expiresAt              DateTime
  /// RASCUNHO PENDENTE = TRUE; qualquer outro estado = NULL. Com o unique
  /// composto abaixo, o banco garante no máximo um rascunho de resposta
  /// pendente por conversa (ADR-044, adendo 1) — mesmo padrão de
  /// `ContactChannelConsent.activeMark` e `Plan.isDefault`, porque Prisma não
  /// expressa índice parcial. Só `send_message` usa a marca: proposta de tarefa
  /// nasce com NULL e não é constrangida.
  pendingReplyMark       Boolean?
  createdAt              DateTime         @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run          AiRun         @relation(fields: [workspaceId, runId], references: [workspaceId, id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [workspaceId, dealId], references: [workspaceId, id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [workspaceId, conversationId], references: [workspaceId, id], onDelete: Cascade)
  reviewedBy   Membership?   @relation("ProposalReviewer", fields: [workspaceId, reviewedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  /// no máximo UM rascunho de resposta pendente por conversa (ADR-044, adendo 1)
  @@unique([workspaceId, conversationId, pendingReplyMark])
  @@index([workspaceId, status, createdAt(sort: Desc)])
}

/// Consentimento do workspace (ADR-028): UMA flag, desligada por padrão.
model AiConsent {
  workspaceId           String   @id @db.Uuid
  /// corpo de mensagem pode entrar no prompt? default NÃO
  conversationContent   Boolean  @default(false)
  updatedByMembershipId String?  @db.Uuid
  updatedAt             DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // FK composta: quem mudou o consentimento é membership DESTE workspace
  updatedBy Membership? @relation("ConsentAuthor", fields: [workspaceId, updatedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Billing e uso (Entrega 8.1) ──────────────────────────────────────────────

/**
 * NATUREZA da métrica (ADR-032). `counter` acumula no período e zera na virada;
 * `gauge` é nível atual — sobe ao criar, desce ao arquivar/excluir, sem período.
 * Misturar as duas é o erro clássico de sistema de quota.
 */
enum UsageMetricKind {
  counter
  gauge
}

enum SubscriptionStatus {
  active
  past_due
  canceled
}

/// Catálogo GLOBAL de planos (como Permission): não é dado de tenant.
model Plan {
  key        String   @id
  name       String
  /// preço em CENTAVOS DE DÓLAR (USD) — dinheiro é Int (§3.11, ADR-034)
  priceCents Int
  /// TRUE ou NULL, nunca FALSE: com `@@unique` o banco garante UM só plano
  /// padrão (mesmo padrão de `Pipeline.defaultMark` e `Channel.systemMark`).
  /// Deixou de ser preferência de provisionamento e passou a decidir TETO de
  /// quem não tem assinatura ativa (ADR-041) — dois padrões dariam limites
  /// diferentes conforme a ordem que o Postgres devolvesse.
  isDefault  Boolean? @unique
  createdAt  DateTime @default(now())

  limits        PlanLimit[]
  subscriptions Subscription[]
}

/// Limite por métrica, em LINHAS consultáveis — nunca um JSON opaco.
model PlanLimit {
  planKey String
  metric  String
  kind    UsageMetricKind
  /// teto no período (counter) ou nível máximo (gauge). BigInt porque bytes de
  /// storage estouram int32 já em 2 GiB — e mudar a unidade para MiB faria
  /// arquivo pequeno arredondar para cima e mentir sobre o consumo.
  value   BigInt

  plan Plan @relation(fields: [planKey], references: [key], onDelete: Cascade)

  @@id([planKey, metric])
}

model Subscription {
  workspaceId        String             @id @db.Uuid
  planKey            String
  status             SubscriptionStatus @default(active)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planKey], references: [key])

  @@index([planKey])
}

/// Uso consolidado. `period` é a chave do mês (YYYY-MM) para counters e string
/// vazia para gauges — que não têm período por definição.
model UsageCounter {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  metric      String
  period      String
  /// BigInt pelo mesmo motivo do PlanLimit.value
  value       BigInt   @default(0)
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // alvo do upsert atômico (ADR-032)
  @@unique([workspaceId, metric, period])
}

/**
 * RESERVA de custo de IA (ADR-033): o teto do run é reservado ANTES da chamada
 * ao provedor e liquidado pelo custo real depois. Reserva órfã (processo morto
 * no meio) expira por idade e é varrida.
 */
model UsageReservation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  metric      String
  period      String
  amount      Int
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric, period])
  @@index([expiresAt])
}

// ─── Usos externos de conteúdo de contato (ADR-047, adendos 6 e 7) ───────────

enum ContentUseKind {
  ai_generation
  ai_message_dispatch
  webhook_delivery
}

enum ContentUseStatus {
  authorized
  concluded
  aborted
  in_doubt
}

enum ContentUseDetector {
  commit
  change
  workspace_change
  reconciliation
  missing_record
  overran_deadline
}

/// Registro DURÁVEL de um uso externo, comitado ANTES da chamada (adendo 7 §3.2).
/// Só ids: nunca conteúdo. `id` vem da aplicação, antes das travas, e dá a
/// trava própria do uso — a prova de que a guarda dele acabou.
model ContentUse {
  id             String              @id @db.Uuid
  workspaceId    String              @db.Uuid
  kind           ContentUseKind
  status         ContentUseStatus
  detectedBy     ContentUseDetector?
  /// o conjunto inteiro de travas: contatos e entidades ('deal:<id>', 'task:<id>')
  contactIds     String[]            @db.Uuid
  entityKeys     String[]
  /// ids do registro de origem (pré-gerados, ou o despacho que já existe)
  origin         Json
  reservationIds String[]            @db.Uuid
  /// IA: o mínimo para criar o run se o processo morrer (só ids e descrições)
  runMetadata    Json?
  instanceId     String
  /// relógio do BANCO (ADR-049): a varredura compara com now()
  authorizedAt   DateTime            @default(dbgenerated("transaction_timestamp()"))
  deadlineAt     DateTime
  finishedAt     DateTime?
  lateAttemptAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([status, deadlineAt])
}

// ─── Automações (Entrega 8.2) ─────────────────────────────────────────────────

/// Ações do CATÁLOGO FECHADO (ADR-035): não existe expressão arbitrária.
enum AutomationAction {
  create_task
}

enum AutomationExecutionStatus {
  executed
  skipped
  failed
}

model Automation {
  id           String           @id @default(uuid()) @db.Uuid
  workspaceId  String           @db.Uuid
  name         String
  /// tipo de evento do outbox (catálogo público) que dispara a automação
  trigger      String
  /// predicados DECLARADOS: [{ field, op, value }] — validados por Zod estrito
  conditions   Json             @default("[]")
  action       AutomationAction
  /// configuração da ação, validada pelo schema do tipo
  actionConfig Json             @default("{}")
  enabled      Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions       AutomationExecution[]
  /// eventos que ESTA automação originou (rastro de causalidade)
  originatedEvents OutboxEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, trigger, enabled])
}

/**
 * Registro de execução. O unique por (automação, evento) é o que torna a
 * reentrega do outbox inofensiva: a segunda tentativa colide e nada é
 * executado de novo (ADR-035).
 */
model AutomationExecution {
  id            String                    @id @default(uuid()) @db.Uuid
  workspaceId   String                    @db.Uuid
  automationId  String                    @db.Uuid
  outboxEventId String                    @db.Uuid
  status        AutomationExecutionStatus
  /// motivo curto quando `skipped`/`failed` — nunca payload nem stack trace
  reason        String?
  createdAt     DateTime                  @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation  Automation  @relation(fields: [workspaceId, automationId], references: [workspaceId, id], onDelete: Cascade)
  outboxEvent OutboxEvent @relation(fields: [workspaceId, outboxEventId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, automationId, outboxEventId])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// ─── Canal externo: WhatsApp (Entrega 9.1) ────────────────────────────────────

/**
 * Credencial DO CANAL (ADR-037). O **app secret** NÃO fica aqui: vive no
 * ambiente/keystore do servidor, porque hoje há um único Meta App. Aqui ficam
 * os dados do número e o token de envio, cifrado (AES-256-GCM). Nada disto
 * aparece em DTO, log, auditoria, cache ou idempotência.
 */
model ChannelCredential {
  channelId         String   @id @db.Uuid
  workspaceId       String   @db.Uuid
  /// id do número no provedor — é a chave de ROTEAMENTO da ingestão
  phoneNumberId     String
  /// id da conta business (WABA), para diagnóstico e templates
  businessAccountId String
  /// token de envio CIFRADO — jamais em claro
  tokenCipher       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)

  /// o número é global no provedor: dois workspaces não podem reivindicá-lo
  @@unique([phoneNumberId])
  // 1:1 com o canal, e a FK é composta
  @@unique([workspaceId, channelId])
  @@index([workspaceId])
}

enum ConsentSource {
  /// formulário/landing com aceite explícito
  form
  /// registrado por um atendente, com evidência fora do sistema
  agent
  /// importado de base anterior, com evidência documentada
  import
}

/**
 * CONSENTIMENTO (ADR-038): evidência com origem, data e revogação. NUNCA é
 * criado por mensagem recebida — mensagem abre janela de atendimento, que é
 * outra coisa. Exigido para mensagem iniciada pelo negócio ou fora da janela.
 */
model ContactChannelConsent {
  id                    String        @id @default(uuid()) @db.Uuid
  workspaceId           String        @db.Uuid
  contactId             String        @db.Uuid
  channelType           ChannelType
  source                ConsentSource
  /// nota curta de evidência (onde/como) — nunca dado sensível
  evidence              String?
  grantedAt             DateTime      @default(now())
  revokedAt             DateTime?
  /// VIGENTE = TRUE; revogado = NULL. Com o unique composto abaixo, o banco
  /// garante no máximo um consentimento ativo por (contato, canal) — mesmo
  /// padrão de `Pipeline.defaultMark` e `Channel.systemMark`. O índice comum
  /// não garantia nada, e o comentário do modelo prometia o que o banco não fazia.
  activeMark            Boolean?
  grantedByMembershipId String?       @db.Uuid

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  grantedBy Membership? @relation("ConsentGranter", fields: [workspaceId, grantedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, contactId, channelType, activeMark])
  @@index([workspaceId, contactId, channelType])
}

enum DispatchState {
  /// reservado ANTES da chamada ao provedor (ADR-039)
  reserved
  /// EM VOO: reivindicado por um worker, com lease e fencing token. Dois
  /// workers não podem chamar a Meta para a mesma mensagem — mensagem
  /// duplicada para um paciente é dano visível.
  sending
  sent
  /// falha comprovadamente anterior ao envio e TRANSITÓRIA (429, rede): o
  /// outbox tenta de novo, e a nova tentativa reserva quota outra vez
  failed_before_send
  /// falha anterior ao envio e DEFINITIVA (template inválido, credencial
  /// recusada): retentar seria repetir o mesmo erro seis vezes
  failed_permanent
  /// timeout/queda após possível despacho: NÃO reenviar, resolver com humano
  unknown_after_dispatch
  /// CANCELADO antes de iniciar (ADR-052, F4.1c-1), pelo serviço neutro de
  /// cancelamento: comprovadamente não enviado, a reserva devolvida, terminal
  canceled
}

/**
 * RESERVA de envio (ADR-039). O unique por mensagem é o que impede o outbox de
 * mandar a mesma mensagem duas vezes quando a resposta do provedor se perde.
 */
model MessageDispatch {
  messageId          String        @id @db.Uuid
  workspaceId        String        @db.Uuid
  state              DispatchState @default(reserved)
  /// reserva de quota VIVA desta tentativa. Falha transitória libera a reserva,
  /// e a retentativa reserva de novo antes de chamar o provedor — senão o teto
  /// não valeria para retentativa.
  reservationId      String?       @db.Uuid
  /// LEASE + FENCING do envio: só o dono do token conclui.
  leaseExpiresAt     DateTime?
  claimToken         String?       @db.Uuid
  /**
   * MARCADOR DE DESPACHO, gravado IMEDIATAMENTE ANTES da chamada ao provedor.
   * É o que distingue "o worker morreu antes de chamar" (seguro reassumir) de
   * "morreu depois de chamar" (pode ter sido entregue — nunca reenviar). Sem
   * ele, lease expirado reenviaria mensagem possivelmente já entregue, que é
   * exatamente o que o ADR-039 existe para impedir.
   */
  dispatchedAt       DateTime?
  /// TEMPLATE pedido no envio, guardado aqui porque o worker REVALIDA a política
  /// imediatamente antes de chamar o provedor (a janela pode fechar e o
  /// consentimento pode ser revogado no caminho). Sem isto o worker não saberia
  /// que o envio era por template.
  templateName       String?
  templateLanguage   String?
  templateParams     Json?
  /// CONTATOS conferidos por quem APROVOU o envio: na aprovação do rascunho da
  /// IA (ADR-047 adendo 7 §9, G3.2), o envio trava e reconfere todos eles,
  /// somados ao contato atual da conversa; na mensagem escrita por pessoa
  /// (ADR-052, revisão da F4.1a), o contato da conversa quando ela escreveu.
  /// O worker não envia a conversa religada desde então. Vazio no despacho
  /// anterior a eles. Sem FK (histórico do que foi conferido), conferido pelo
  /// `check:fk`.
  approvalContactIds String[]      @db.Uuid
  /// ORIGEM DE IA: o despacho nasceu da aprovação de uma proposta da IA, editada
  /// ou não (decisão de 2026-10-21, ADR-047 adendo 7 §9, G3.2). Editar não
  /// remove a origem: o envio passa pela restrição e pela guarda como o da IA.
  /// A autoria (`Message.authorType`) é outro fato e não muda.
  fromAiProposal     Boolean       @default(false)
  /// id no provedor (wamid), conhecido só depois do envio bem-sucedido
  externalId         String?
  /// código curto do provedor — nunca corpo de resposta nem stack trace
  errorCode          String?
  /// o PEDIDO de cancelamento (ADR-052, F4.1c-1), gravado pelo cancelamento
  /// neutro: vale enquanto a chamada não começou — a reconferência sob a
  /// guarda e a falha que prova o não envio levam o despacho a `canceled`. Só
  /// a presença decide; o instante é informativo
  cancelRequestedAt  DateTime?
  /// o motivo do pedido, gravado junto com ele (lista fechada do serviço): é o
  /// `errorCode` do despacho que termina `canceled` por qualquer caminho
  cancelReason       String?
  attempts           Int           @default(0)
  createdAt          DateTime      @default(now())
  /// Mantido pelo BANCO (ADR-049): DEFAULT na criação e trigger que grava
  /// `now()` em todo UPDATE cujo valor novo é igual ao antigo (quem não define
  /// a coluna). A varredura compara com
  /// `now()`, então quem escreve é o mesmo relógio — nunca o `@updatedAt` do
  /// Prisma, que usa o relógio do Node.
  updatedAt          DateTime      @default(dbgenerated("transaction_timestamp()"))

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, externalId])
  @@index([workspaceId, state])
  @@index([state, leaseExpiresAt])
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

/**
 * RECIBOS (ADR-039): `Message` é append-only, então status não é UPDATE. Cada
 * fato é uma linha com o timestamp DO PROVEDOR; recibos chegam repetidos e fora
 * de ordem, então o unique deduplica e o estado atual é DERIVADO na leitura.
 */
model MessageStatusEvent {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  messageId   String        @db.Uuid
  status      MessageStatus
  /// timestamp informado pelo provedor — a ordem é dele, não a de chegada
  occurredAt  DateTime
  errorCode   String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   Message   @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)

  /// reentrega do mesmo recibo não duplica o fato
  @@unique([workspaceId, messageId, status])
  @@index([workspaceId, messageId, occurredAt])
}

enum InboundMediaState {
  /// referência registrada; bytes ainda no provedor
  pending
  fetched
  failed
}

/**
 * Referência de MÍDIA recebida (ADR-037). O webhook público registra apenas
 * isto — baixar ali daria a um chamador externo o poder de nos fazer buscar
 * conteúdo arbitrário. A coleta autenticada acontece depois e cria o
 * `FileObject` com `scanStatus: pending`.
 * É uma TABELA e não um evento de outbox porque evento interno sem consumidor
 * é entrega perdida: o dispatcher marcaria como entregue e a referência
 * desapareceria. A coleta entra na 9.1.b, junto do transporte autenticado.
 */
model InboundMedia {
  id              String            @id @default(uuid()) @db.Uuid
  workspaceId     String            @db.Uuid
  messageId       String            @db.Uuid
  /// id da mídia NO PROVEDOR — opaco, sem tabela local para referenciar
  providerMediaId String
  mimeType        String
  fileName        String?
  state           InboundMediaState @default(pending)
  /// LEASE + FENCING da coleta (mesmo padrão do outbox): dois workers não podem
  /// baixar e gravar a mesma mídia. Só é reivindicável quem está `pending` ou
  /// com lease expirado, e só o dono do token conclui.
  claimedAt       DateTime?
  leaseExpiresAt  DateTime?
  claimToken      String?           @db.Uuid
  fileObjectId    String?           @db.Uuid
  /// código curto do motivo quando `failed` — nunca resposta do provedor
  errorCode       String?
  attempts        Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message    Message     @relation(fields: [workspaceId, messageId], references: [workspaceId, id], onDelete: Cascade)
  fileObject FileObject? @relation(fields: [workspaceId, fileObjectId], references: [workspaceId, id], onDelete: SetNull)

  /// reentrega do mesmo evento não cria segunda referência
  @@unique([workspaceId, messageId, providerMediaId])
  @@index([workspaceId, state])
  @@index([state, leaseExpiresAt])
}

enum TemplateStatus {
  /// registrado aqui e aprovado na Meta (registro MANUAL nesta entrega)
  approved
  /// registrado mas não liberado para uso
  paused
}

/**
 * Template aprovado, necessário para mensagem FORA da janela de atendimento
 * (ADR-038). O registro é MANUAL nesta entrega: sincronizar o catálogo da Meta
 * exige WABA real e é trabalho próprio. Sem sync, ainda validamos a forma do
 * envio e recusamos template desconhecido — que é o que impede o erro mais
 * comum do primeiro envio real.
 */
model MessageTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid
  channelId   String         @db.Uuid
  /// nome exato aprovado na Meta
  name        String
  language    String
  /// quantidade de parâmetros do corpo — o envio precisa casar exatamente
  paramCount  Int            @default(0)
  status      TemplateStatus @default(approved)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel   @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, channelId, name, language])
  @@index([workspaceId, channelId])
}

// ── F4.1c-2: templates versionados, revisados e relidos (ADR-052 item 4) ──────

enum TemplateCategory {
  utility
  marketing
}

enum TemplateParameterFormat {
  /// `{{1}}`, `{{2}}`
  positional
  /// `{{nome}}`
  named
}

enum TemplateVersionStatus {
  /// o conteúdo que a Meta mostrou no cadastro
  active
  /// a Meta mostrou outro conteúdo (um cadastro mais novo ou a releitura): a
  /// versão nunca mais é usada
  divergent
}

/// A VERSÃO de um template do WhatsApp (ADR-052 item 4, F4.1c-2), lida da Meta
/// pela CLI administrativa. O conteúdo é IMUTÁVEL: mudou o conteúdo, a
/// categoria ou o vínculo, nasce uma versão nova. Só o `status` muda, de
/// `active` para `divergent`, uma vez (`OUTCOME_ONLY_MODELS` no client e o
/// gatilho `template_version_guard` no banco). Não autoriza envio nesta
/// subentrega. O `MessageTemplate` da 9.1 fica como histórico.
model MessageTemplateVersion {
  id                String                  @id @default(uuid()) @db.Uuid
  workspaceId       String                  @db.Uuid
  channelId         String                  @db.Uuid
  /// a WABA de onde a versão saiu: o envio da Meta acha o template pelo nome e
  /// pelo idioma NA WABA do número, e a credencial com outra WABA diverge a versão
  businessAccountId String
  /// o id do template na Meta: a releitura exige o mesmo id na mesma WABA
  metaTemplateId    String
  name              String
  language          String
  /// 1, 2, … por (canal, nome, idioma)
  version           Int
  category          TemplateCategory
  parameterFormat   TemplateParameterFormat
  /// a forma CANÔNICA: só os componentes aceitos, sem `example` nem mídia
  components        Json
  /// parâmetro (`header.1`, `body.nome`) → campo do catálogo; nunca o valor
  bindings          Json
  /// SHA-256 da forma canônica com os vínculos (nome, idioma, categoria, formato)
  contentHash       String
  status            TemplateVersionStatus   @default(active)
  createdAt         DateTime                @default(dbgenerated("transaction_timestamp()"))

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel          @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  reviews   TemplateReview[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, channelId, name, language, version])
  @@index([workspaceId, channelId, name, language])
}

/// A REVISÃO de uma versão de template para uma versão de finalidade (ADR-052
/// item 4, F4.1c-2), por quem tem `templates:review`: quem, quando e o hash
/// que viu. Append-only. Vale só para aquele conteúdo e aquela finalidade.
model TemplateReview {
  id                     String   @id @default(uuid()) @db.Uuid
  workspaceId            String   @db.Uuid
  templateVersionId      String   @db.Uuid
  purposeId              String   @db.Uuid
  /// o `contentHash` que a pessoa viu (igual ao da versão)
  contentHash            String
  reviewedByMembershipId String   @db.Uuid
  createdAt              DateTime @default(dbgenerated("transaction_timestamp()"))

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templateVersion MessageTemplateVersion @relation(fields: [workspaceId, templateVersionId], references: [workspaceId, id], onDelete: Cascade)
  purpose         ConsentPurpose         @relation(fields: [workspaceId, purposeId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy      Membership             @relation(fields: [workspaceId, reviewedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, templateVersionId, purposeId])
  @@index([workspaceId, purposeId])
}

// ── F4.1b: finalidades, consentimentos e o pedido de parar (ADR-052 item 5) ──

enum ConsentOrigin {
  /// a pessoa, presente
  in_person
  /// por telefone
  phone
  /// formulário em papel
  paper_form
}

enum ConsentPurposeCategory {
  utility
  marketing
}

enum ConsentRevocationReason {
  /// a pessoa pediu a revogação
  manual
  /// o número saiu do cadastro do contato
  number_removed
  /// o pedido de parar daquele número
  stop_requested
}

/// A FINALIDADE versionada (ADR-052 item 5, C1): o que a pessoa consente.
/// Imutável (append-only no client); qualquer mudança é versão nova, criada só
/// pela CLI administrativa, com auditoria. Um consentimento de versão anterior
/// não autoriza a versão nova.
model ConsentPurpose {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  key         String
  version     Int
  /// a descrição mostrada à pessoa
  description String
  category    ConsentPurposeCategory
  /// a lista FECHADA de campos que um envio desta finalidade pode usar
  fields      String[]
  createdAt   DateTime               @default(dbgenerated("transaction_timestamp()"))

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  consents        Consent[]
  templateReviews TemplateReview[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, key, version])
}

/// O CONSENTIMENTO por (contato, canal do negócio, número exato, versão da
/// finalidade) — ADR-052 item 5, decisões de 2026-10-26. A concessão é
/// imutável; nasce ativa e só a revogação se preenche, uma vez, garantido no
/// client (só esses campos) e no banco (gatilho e CHECK de coerência). Os
/// instantes são do banco, gravados pelo gatilho depois das travas. A cascata
/// da exclusão do contato apaga.
model Consent {
  id                    String                   @id @default(uuid()) @db.Uuid
  workspaceId           String                   @db.Uuid
  contactId             String                   @db.Uuid
  channelId             String                   @db.Uuid
  /// "+dígitos": a forma exata do número (a normalizada, ou o mesmo número
  /// internacional com "+"), igual ao endereço da conversa
  number                String
  purposeId             String                   @db.Uuid
  origin                ConsentOrigin
  /// `CON-000001`: emitido pelo servidor; identifica o registro, não prova sozinho o consentimento
  receipt               String
  /// a fotografia da descrição aceita
  purposeDescription    String
  grantedAt             DateTime                 @default(dbgenerated("transaction_timestamp()"))
  grantedByMembershipId String                   @db.Uuid
  revokedAt             DateTime?
  revokedByMembershipId String?                  @db.Uuid
  revocationReason      ConsentRevocationReason?
  /// a origem da manifestação na revogação manual
  revocationOrigin      ConsentOrigin?
  /// true enquanto ativo, NULL depois da revogação: o único por tupla só vale para o ativo
  activeMark            Boolean?                 @default(true)

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact        @relation(fields: [workspaceId, contactId], references: [workspaceId, id], onDelete: Cascade)
  channel   Channel        @relation(fields: [workspaceId, channelId], references: [workspaceId, id], onDelete: Cascade)
  purpose   ConsentPurpose @relation(fields: [workspaceId, purposeId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  grantedBy Membership     @relation("PurposeConsentGrantedBy", fields: [workspaceId, grantedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  revokedBy Membership?    @relation("PurposeConsentRevokedBy", fields: [workspaceId, revokedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, receipt])
  @@unique([workspaceId, contactId, channelId, number, purposeId, activeMark])
  @@index([workspaceId, number])
  @@index([workspaceId, channelId])
  @@index([workspaceId, purposeId])
}

/// O PEDIDO DE PARAR (ADR-052 item 5, C4 e C16): por (workspace, número), para
/// todos os canais do workspace. Guarda só o necessário para impedir contato
/// novo — sem contato nem nome — e sobrevive à exclusão do contato. Guarda a
/// membership de quem registrou e de quem desbloqueou. Nasce ativo e só o
/// desbloqueio se preenche, uma vez (client, gatilho e CHECK), e ele não
/// restaura consentimento. Os instantes são do banco, depois das travas.
model StopBlock {
  id                    String         @id @default(uuid()) @db.Uuid
  workspaceId           String         @db.Uuid
  /// "+dígitos": a forma exata do número
  number                String
  origin                ConsentOrigin
  /// `PAR-000001`
  receipt               String
  createdAt             DateTime       @default(dbgenerated("transaction_timestamp()"))
  createdByMembershipId String         @db.Uuid
  liftedAt              DateTime?
  liftedByMembershipId  String?        @db.Uuid
  /// a origem da NOVA solicitação da pessoa
  liftOrigin            ConsentOrigin?
  /// `DES-000001`
  liftReceipt           String?
  activeMark            Boolean?       @default(true)

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Membership  @relation("StopBlockCreatedBy", fields: [workspaceId, createdByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)
  liftedBy  Membership? @relation("StopBlockLiftedBy", fields: [workspaceId, liftedByMembershipId], references: [workspaceId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([workspaceId, id])
  @@unique([workspaceId, receipt])
  @@unique([workspaceId, liftReceipt])
  @@unique([workspaceId, number, activeMark])
}

/// O contador dos recibos (`CON-`, `PAR-`, `DES-`) por workspace: único, sem
/// reutilização e sem truncar; não promete sequência contínua.
model ConsentReceiptCounter {
  workspaceId String @id @db.Uuid
  next        BigInt @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// O LIVRO do preenchimento de permissões (ADR-052 item 6 do plano da F4.1b):
/// cada concessão feita por uma migration fica registrada, e a reaplicação
/// pula o que já foi feito — uma revogação posterior não é desfeita. Ele não
/// prova que a concessão inicial respeita toda intenção anterior.
model PermissionBackfill {
  id            String   @id @default(uuid()) @db.Uuid
  workspaceId   String   @db.Uuid
  roleId        String   @db.Uuid
  permissionKey String
  appliedAt     DateTime @default(dbgenerated("transaction_timestamp()"))

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [workspaceId, roleId], references: [workspaceId, id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key])

  @@unique([workspaceId, roleId, permissionKey])
}
