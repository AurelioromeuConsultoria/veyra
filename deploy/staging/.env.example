# ── Veyra staging — MODELO ────────────────────────────────────────────────────
# ESTE ARQUIVO É SÓ MODELO. No ambiente real (recurso do Coolify), cada
# variável abaixo é cadastrada no PAINEL, no recurso do Veyra — mesmo padrão do
# VerboPlus, adotado lá depois de um incidente de segredo versionado no git
# (ADR-046, adendo 1). Nada aqui recebe valor real.
#
# Gere cada segredo com: openssl rand -base64 48
# E guarde os valores num gerenciador de senhas FORA da VPS: se o banco do
# Coolify se perder, as variáveis vão junto.

# ── identidade do ambiente ───────────────────────────────────────────────────
VEYRA_HOST=veyra-staging.malachdigital.com.br
# Marca o ambiente. É o que autoriza comportamentos que NÃO podem existir em
# produção — hoje, o transporte falso do WhatsApp (ver ADR proposto).
VEYRA_ENV=staging
NODE_ENV=production

# ── banco (interno ao projeto; sem porta publicada) ──────────────────────────
POSTGRES_USER=veyra
POSTGRES_PASSWORD=TROQUE-openssl-rand-base64-48
POSTGRES_DB=veyra

# ── autenticação e cifra ─────────────────────────────────────────────────────
# Chaves INDEPENDENTES: a de cifra protege token de canal em repouso; se fosse
# a mesma do JWT, vazar uma entregaria as duas (CLAUDE.md §3.12)
JWT_SECRET=TROQUE-min-32-caracteres
TOKEN_ENCRYPTION_KEY=TROQUE-independente-do-jwt
# Chave do HMAC das travas de endereço (ADR-052 item 3): independente das duas
# acima e ESTÁVEL — as chaves `address:` ficam no registro dos usos, então ela
# não muda entre deploys. Rotação só em manutenção (docs/SECURITY.md §8).
# Gere com: openssl rand -base64 48. O valor de exemplo não sobe em produção.
ADDRESS_LOCK_KEY=TROQUE-independente-e-estavel-min-32
# Chave do HMAC da aprovação do envio do negócio (approvalHash, ADR-052 item 8,
# F4.1c-3): independente das outras e a MESMA em todos os processos. Trocá-la
# invalida as aprovações pendentes, que não saem (approval_stale).
# Gere com: openssl rand -base64 48. O valor de exemplo não sobe em produção.
OUTBOUND_APPROVAL_KEY=TROQUE-chave-da-aprovacao-min-32

# ── canal externo (Meta) ─────────────────────────────────────────────────────
# Em staging o transporte é FALSO e nada sai para a Meta. Os dois segredos
# abaixo continuam necessários porque o webhook valida assinatura HMAC mesmo
# com transporte falso — use valores de teste, jamais os do app real.
META_APP_SECRET=TROQUE-valor-de-teste
META_WEBHOOK_VERIFY_TOKEN=TROQUE-valor-de-teste
# `fake` = nada sai para a Meta (ADR-046). O boot é RECUSADO se este valor
# aparecer com VEYRA_ENV diferente de `staging`.
META_TRANSPORT_MODE=fake

# Kill switch dos jobs (worker do outbox, varreduras e reconciliação). `true`
# só no deploy da guarda, entre a subida do código novo e as migrations
# (DEPLOY_STAGING §4). Valores aceitos: true | false.
DISABLE_JOBS=false

# ── IA ───────────────────────────────────────────────────────────────────────
# Deixe VAZIO para staging sem custo: cada capacidade degrada com clareza.
# Com chave, o gasto é real e aparece em /usage.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── retenção ─────────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=365
AI_RESULT_RETENTION_DAYS=90

# ── proxy (Traefik do Coolify — medido no diagnóstico de 25/08/2026) ─────────
# Rede onde o `coolify-proxy` alcança os containers.
PROXY_NETWORK=coolify
# Resolver de certificado que a casa já usa; o mesmo do VerboPlus em produção.
CERT_RESOLVER=letsencrypt

# ── scanner de arquivos ──────────────────────────────────────────────────────
# VAZIO = sem scanner: arquivo fica `pending` e não sai para canal externo
# (ADR-043). É a recomendação para staging nesta VPS, que tem pouca memória
# livre. Para ligar: preencha com `clamav` E suba com `--profile scanner`.
CLAMAV_HOST=

# ── backup (destino EXTERNO à VPS) ───────────────────────────────────────────
# Backup no mesmo disco que ele protege não é backup. Exemplos de destino:
#   s3:s3.amazonaws.com/meu-bucket/veyra-staging
#   b2:meu-bucket:veyra-staging
#   sftp:usuario@host:/caminho/veyra-staging
RESTIC_REPOSITORY=
# PERDER esta senha torna TODO backup ilegível. Guarde fora da VPS.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_AT=03:15
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6
